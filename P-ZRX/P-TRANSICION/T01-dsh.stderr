    b = por_id[id]
    b.familia == Genesis && continue
    Ep = get(memo, b.padre, nothing)
    Ep === nothing && continue
    h0 = hash_canonico(Ep)
    r = aplicar_con_undo(Ep, b, P)
    r isa Err && continue  # shouldn't happen
    E2, undo = r
    E3 = deshacer(E2, undo)
    @test hash_canonico(E3) == h0
    @test hash_canonico(Ep) == h0   # no mutación
end
# I-3: seleccionar vs nodo sobre permutaciones
res = seleccionar(bloques, P)
if res.punta != -1
    n = length(bloques)
    perms = n <= 7 ? permutations(1:n) : ...
    ...
end
```

