```
function obtener_garantia!(E,key)
    g = get(E.garantias, key, nothing)
    if g === nothing
        g = Garantia(UInt64(0), Pendiente[], EnRetirada[], UInt64(0), Pendiente[])
        E.garantias[key] = g
    end
    return g
end
```
Since Garantia is mutable, fine.

add_activo!/sub_activo!:
```
function add_activo!(g,c)
    r, ovf = Base.Checked.add_with_overflow(g.activo,c)
    ovf && return ErrDesbordamiento
    g.activo = r; return nothing
end
function sub_activo!(g,c)
    r, ovf = Base.Checked.sub_with_overflow(g.activo,c)
    ovf && return ErrSaldo
    g.activo = r; return nothing
end
```

`suma_monetaria(a,b)`:
```
function suma_monetaria(a::UInt64,b::UInt64)
    r, ovf = Base.Checked.add_with_overflow(a,b)
    ovf && return ErrDesbordamiento
    return r
end
```

Now, `promover!`:
```
function promover!(E, punto, es_post)
    for (k,g) in E.garantias
        if es_post
            # pendientes with slot maturity
            quedan = Pendiente[]
            for p in g.pendientes
                if p.madura_en_slot != -1 && p.madura_en_slot <= punto
                    r = add_activo!(g,p.importe); r isa Err && return r
                else
                    push!(quedan,p)
                end
            end
            g.pendientes = quedan
            quedanc = Pendiente[]
            for p in g.creditos
                if p.madura_en_slot != -1 && p.madura_en_slot <= punto
                    r = add_activo!(g,p.importe); r isa Err && return r
                else
                    push!(quedanc,p)
                end
            end
            g.creditos = quedanc
        else
            quedan = Pendiente[]
            for p in g.pendientes
                if p.madura_en_altura != -1 && p.madura_en_altura <= punto
                    r = add_activo!(g,p.importe); r isa Err && return r
                else
                    push!(quedan,p)
                end
            end
            g.pendientes = quedan
        end
    end
    return nothing
end
```

