Let me code:

```julia
function backbone(rng::AbstractRNG, P::Params; max_altura::Int=9)
    bloques = Bloque[]
    g = Bloque(id=1, familia=Genesis, padre=0, altura=0, txs=Tx[])
    push!(bloques, g)
    E = aplicar(estado_inicial(P), g, P)
    E isa Err && error("génesis inválido: $E")
    next_id = 2
    out_id = 1000
    prod = 1
    sector_alta = false
    sector_probado = false
    sid = 1
    h = 0
    while h < max_altura
        h += 1
        txs = Tx[]
        # ---- coinbase ----
        outs = Salida[]
        if h == 1
            push!(outs, Salida(out_id, UInt64(5), 1, OrigenTx, -1, -1))
            out_id += 1
            push!(outs, Salida(out_id, UInt64(5), 2, OrigenTx, -1, -1))
            out_id += 1
        else
            push!(outs, Salida(out_id, UInt64(10), prod, OrigenTx, -1, -1))
            out_id += 1
        end
        push!(txs, TxCoinbase(outs))
        # ---- deposits from matured coinbase outputs ----
        if h >= P.H_dep
            maduras = Salida[]
            for (_, o) in E.utxo
                if o.origen == OrigenCoinbasePow && h >= o.creada_en_altura + P.M_cb
                    push!(maduras, o)
                end
            end
            # deposit each matured output to its owner
            for o in sort(maduras, by = x->x.id)
                push!(txs, TxDeposito([o.id], o.dueño, Int(o.valor), o.dueño))
            end
        end
        # ---- sectores SEC-A ----
        if P.sec == SECA
            if !sector_alta && h >= P.H_dep
                push!(txs, TxAltaSector(sid, prod, prod))
                sector_alta = true
            end
            if sector_alta && !sector_probado
                push!(txs, TxPruebaSector(sid, prod))
                sector_probado = true
            end
        end
        B = Bloque(id=next_id, familia=PoW, padre=bloques[end].id, altura=h, trabajo=1, txs=txs)
        r = aplicar(E, B, P)
        if r isa Err
            # fallback: retry without optional txs (keep coinbase)
            B2 = Bloque(id=next_id, familia=PoW, padre=bloques[end].id, altura=h, trabajo=1, txs=[TxCoinbase(outs)])
            r = aplicar(E, B2, P)
            r isa Err && error("no se pudo construir PoW en h=$h: $r")
            B = B2
        end
        E = r
        push!(bloques, B)
        next_id += 1
        E.terminal == B.id && break
    end
    return bloques, E, next_id, out_id, prod
end
```

Hmm, the deposit loop deposits ALL matured coinbase outputs each block. At h=1, outputs created at h=1 are not mature (M_cb≥1), so no deposit. At h=2, if M_cb=1, deposit the h=1 outputs (5+5). Then at h=2's coinbase, output 10 to prod. At h=3, deposit the h=2 output. Etc. So garantía accumulates. Total at terminal could be large. That's fine (S_min up to 10).

But wait: the deposit of the h=1 outputs to keys 1,2 gives 5 each, total 10. Then later deposits add more. Fine.

However, there's a problem: the sector alta at h=2 requires h≥H_dep. If H_dep=1 and h=1, alta at h=1. But at h=1 the coinbase outputs (5+5) are created in the same block; deposits can't consume them (immature). Fine.

Also, the deposit loop consumes matured outputs; but the sector alta/proof txs are appended after. The order applies txs in list order. Fine.

Now, `out_id` must not collide across blocks. I increment. Good.

