```julia
# --- constructores ---
genesis_bloque(; id=1) = Bloque(id=id, familia=Genesis, padre=0, altura=0, txs=Tx[])

function mk_pow(; id, padre, altura, txs, trabajo=1, pow_ok=true)
    Bloque(id=id, familia=PoW, padre=padre, altura=altura, trabajo=trabajo, pow_ok=pow_ok, txs=txs)
end

function mk_post(; id, padre, slot, productor, peso=1, sector=0, req=0, txs=Tx[])
    Bloque(id=id, familia=PoST, padre=padre, slot=slot, productor=productor, peso=peso, sector=sector, requisito_declarado=req, txs=txs)
end
```

Backbone:
```julia
function construir_poW(rng, P; max_altura=10, prod=1, trabajo=1, depositar=true, sectores=nothing)
    use_sec = sectores === nothing ? (P.sec == SECA) : sectores
    bloques = Bloque[genesis_bloque()]
    E = aplicar(estado_inicial(P), bloques[1], P)
    estados = Estado[E]
    next_id = 2
    out_id = 1000
    sid = 1
    alta_hecha = false
    prueba_hecha = false
    for h in 1:max_altura
        txs = Tx[]
        # coinbase
        if h == 1
            push!(txs, TxCoinbase([Salida(out_id, UInt64(5), 1, OrigenTx, -1, -1),
                                   Salida(out_id+1, UInt64(5), 2, OrigenTx, -1, -1)]))
            out_id += 2
        else
            push!(txs, TxCoinbase([Salida(out_id, UInt64(10), prod, OrigenTx, -1, -1)]))
            out_id += 1
        end
        # tentative state after coinbase
        Ebase = E
        # helper: try to append cand
        # We'll rebuild the block each time.
        txs_ok = copy(txs)
        Et = nothing
        # apply just coinbase
        let B = mk_pow(id=next_id, padre=bloques[end].id, altura=h, txs=txs_ok, trabajo=trabajo)
            r = aplicar(Ebase, B, P)
            if r isa Err
                error("coinbase inválida en h=$h: $r")
            end
            Et = r
        end
        function intentar(cand)
            push!(txs_ok, cand)
            B = mk_pow(id=next_id, padre=bloques[end].id, altura=h, txs=txs_ok, trabajo=trabajo)
            r = aplicar(Ebase, B, P)
            if r isa Err
                pop!(txs_ok)
                return nothing
            end
            return r
        end
        # deposits
        if depositar && h >= P.H_dep
            maduras = Salida[]
            for (_, o) in Et.utxo
                if o.origen == OrigenCoinbasePow && h >= o.creada_en_altura + P.M_cb
                    push!(maduras, o)
                end
            end
            sort!(maduras, by = x->x.id)
            for o in maduras
                r2 = intentar(TxDeposito([o.id], o.dueño, Int(o.valor), o.dueño))
                r2 === nothing || (Et = r2)
            end
        end
        # transfer (opcional)
        if rand(rng) < 0.5
            gastables = Salida[]
            for (_, o) in Et.utxo
                gastable(Et, o, P, h) && Int(o.valor) >= 2 && push!(gastables, o)
            end
            if !isempty(gastables)
                o = gastables[rand(rng, 1:length(gastables))]
                destino = rand(rng, 1:3)
                r2 = intentar(TxTransferencia([o.id],
                              [Salida(out_id, o.valor - UInt64(1), destino, OrigenTx, -1, -1)],
                              o.dueño))
                if r2 !== nothing
                    Et = r2; out_id += 1
                end
            end
        end
        # sectores
        if use_sec
            if !alta_hecha && h >= P.H_dep
                r2 = intentar(TxAltaSector(sid, prod, prod))
                if r2 !== nothing; Et = r2; alta_hecha = true; end
            end
            if alta_hecha && !prueba_hecha
                r2 = intentar(TxPruebaSector(sid, prod))
                if r2 !== nothing; Et = r2; prueba_hecha = true; end
            end
        end
        B = mk_pow(id=next_id, padre=bloques[end].id, altura=h, txs=txs_ok, trabajo=trabajo)
        r = aplicar(Ebase, B, P)
        r isa Err && error("bloque PoW falló tras construir: $r")
        E = r
        push!(bloques, B); push!(estados, E)
        next_id += 1
        E.terminal == B.id && break
    end
    return bloques, estados, next_id, out_id, prod
end
```

Wait, there's a bug: after `intentar` accepts a tx, `Et` is updated. But then a later `intentar` builds the block with `txs_ok` (which includes all accepted txs) and applies from `Ebase`. Good. But the candidate generation uses `Et` (state after accepted txs). Good.

However, closures capturing and mutating `out_id` inside `intentar`? `out_id` is a local variable in the function; the closure `intentar` doesn't modify it. The transfer block modifies `out_id` after `intentar` returns. Fine. But in Julia, closures capture variables by reference; `txs_ok` is mutated inside `intentar` via push!/pop!. That works.

Hmm, one issue: defining a closure `intentar` inside a loop in Julia creates a new closure each iteration; fine.

Another issue: `E.terminal == B.id` — after applying, E.terminal may be set. Good.

Now, the sector alta requires h≥H_dep. But the sector's `prueba` might need to be at a height ≤ alta+P_sec. If we prove in the same block, fine.

Now, there's a subtle bug: `intentar` applies the block from `Ebase`, which is the parent state. If the block's txs include a transfer whose input was created by the coinbase in the same block, `gastable` would be false for coinbase (immature), so it wouldn't be selected as `gastables` (the scan uses `Et.utxo` which includes the coinbase output, but `gastable(Et,o,P,h)` for a same-block coinbase is false). Good.

Now the PoST extension:
```julia
function extender_post(rng, P, bloques, estados, next_id, out_id, prod; max_post=3)
    E = estados[end]
    parent = bloques[end].id
    slot = 0
    retiro_hecho = false
    for i in 1:max_post
        slot += rand(rng, 1:2)
        txs = Tx[]
        # coinbase post
        push!(txs, TxCoinbasePost(3))
        # sector field
        sector = (P.sec == SECA) ? 1 : 0
        # try txs greedily
        Ebase = E
        txs_ok = copy(txs)
        B0 = mk_post(id=next_id, padre=parent, slot=slot, productor=prod, peso=1, sector=sector, txs=txs_ok)
        r = aplicar(Ebase, B0, P)
        r isa Err && break
        Et = r
        function intentar_post(cand)
            push!(txs_ok, cand)
            B = mk_post(id=next_id, padre=parent, slot=slot, productor=prod, peso=1, sector=sector, txs=txs_ok)
            rr = aplicar(Ebase, B, P)
            if rr isa Err
                pop!(txs_ok)
                return nothing
            end
            return rr
        end
        # retiro
        g = get(Et.garantias, prod, nothing)
        if !retiro_hecho && g !== nothing && g.activo > UInt64(P.q)
            r2 = intentar_post(TxRetiro(prod, 1, prod))
            if r2 !== nothing; Et = r2; retiro_hecho = true; end
        end
        # liberacion
        gl = get(Et.garantias, prod, nothing)
        if gl !== nothing && !isempty(gl.en_retirada)
            for er in gl.en_retirada
                if er.inicio_slot + P.R_slots <= slot
                    r2 = intentar_post(TxLiberacion(prod, er.importe, prod))
                    if r2 !== nothing; Et = r2; break; end
                end
            end
        end
        # transfer
        if rand(rng) < 0.5
            gastables = [o for (_,o) in Et.utxo if gastable(Et,o,P,slot) && Int(o.valor)>=2]
            if !isempty(gastables)
                o = gastables[rand(rng,1:length(gastables))]
                r2 = intentar_post(TxTransferencia([o.id], [Salida(out_id, o.valor-UInt64(1), rand(rng,1:3), OrigenTx, -1, -1)], o.dueño))
                if r2 !== nothing; Et = r2; out_id += 1; end
            end
        end
        B = mk_post(id=next_id, padre=parent, slot=slot, productor=prod, peso=1, sector=sector, txs=txs_ok)
        r = aplicar(Ebase, B, P)
        r isa Err && break
        E = r
        push!(bloques, B); push!(estados, E)
        next_id += 1
        parent = B.id
    end
    return bloques, estados, next_id, out_id
end
```

Wait, there's a bug with the retiro: after a retiro, `g.en_retirada` is non-empty, so a second retiro would give ErrRetiroPendiente. I guard with `retiro_hecho`. But the retiro reduces garantía; the producer check for the *next* block needs garantía ≥ q. With plenty of deposits, fine.

Also, the liberation after R_slots: if retiro in PoST at slot s0, liberation needs slot ≥ s0+R_slots. Since slots increase, maybe within max_post=3 it won't reach. Let me set retiro in PoW instead, so inicio_slot=0 and liberation at slot ≥ R_slots (R_slots up to 3). Or just increase max_post.

Hmm. Let me add a retiro in the backbone at some late PoW height (before terminal) to exercise it. But it reduces activo, possibly breaking Φ. If I retiro only 1 and activo is large (≥10), fine.

Actually, let me not add retiro in the backbone (could break terminal), and in PoST, add retiro early and hope to liberate. With R_slots=3 and slots incrementing by 1-2, 3 PoST blocks might reach slot ~4. Liberation at slot≥3. Could work. If not, the retiro stays en_retirada; I-1 still checks it. Fine.

Now, the generator `generar_historia(rng,P)`:
```julia
function generar_historia(rng, P; max_altura=9)
    bloques, estados, next_id, out_id, prod = construir_poW(rng, P; max_altura=max_altura)
    if estados[end].fase == FasePoW && estados[end].terminal != -1
        bloques, estados, next_id, out_id = extender_post(rng, P, bloques, estados, next_id, out_id, prod)
    end
    # inyectar inválidos
    n_validos = length(estados)
    n_invalidos = 0
    objetivo = n_validos  # mitad válidos
    while n_invalidos < n_validos
        b = bloque_invalido(rng, bloques, P)
        push!(bloques, b)
        n_invalidos += 1
    end
    return bloques
end
```

Hmm, but injecting invalid blocks requires them not to accidentally be valid. Let me craft them to fail: e.g., a PoW block with `pow_ok=false`, or a PoST block with productor=9999. Their parent can be any existing block. Even if the parent is invalid, they're invalid. Good.

But wait: if I add an invalid block with a fresh id whose parent is a valid PoW block and it has `pow_ok=false`, it fails → discarded. Good.

Let me write `bloque_invalido`:
```julia
function bloque_invalido(rng, bloques, P)
    idmax = maximum(b.id for b in bloques) + 1
    padre = bloques[rand(rng, 1:length(bloques))].id
    tipo = rand(rng, 1:4)
    if tipo == 1
        return mk_pow(id=idmax, padre=padre, altura=0, txs=Tx[], pow_ok=false)
    elseif tipo == 2
        return mk_pow(id=idmax, padre=padre, altura=0, txs=[TxCoinbase([Salida(900000+idmax, UInt64(100), 1, OrigenTx, -1, -1)])])
    elseif tipo == 3
        return mk_post(id=idmax, padre=padre, slot=0, productor=9999, peso=1)
    else
        return mk_post(id=idmax, padre=padre, slot=1, productor=9999, peso=0)
    end
end
```
Note: `altura=0` for a PoW block whose parent is at altura 5 → ErrSlot. Fine. The coinbase type: if the parent is at a valid PoW height h, then `B.altura` (0) != E.altura+1 → ErrSlot before the coinbase check. Hmm, so it fails with ErrSlot, not ErrEmision. But for the generator, it just needs to be invalid. Fine.

Actually, for the injected invalid blocks, I want them clearly invalid. Using wrong altura is fine.

But there's a subtlety: `construir_validos` iterates all blocks; an invalid block doesn't enqueue. Fine.

