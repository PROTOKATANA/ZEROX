#### I-1 check (for tests)

```julia
function suma_utxo(E)::Int128
    s = Int128(0)
    for (_, o) in E.utxo; s += Int128(o.valor); end
    s
end
function suma_garantias(E)::Int128
    s = Int128(0)
    for (_, g) in E.garantias
        s += Int128(g.activo) + Int128(g.congelado)
        for p in g.pendientes; s += Int128(p.importe); end
        for p in g.creditos; s += Int128(p.importe); end
        for r in g.en_retirada; s += Int128(r.importe); end
    end
    s
end
invariante_I1(E) = suma_utxo(E) + suma_garantias(E) == E.emitido - E.quemado
```

