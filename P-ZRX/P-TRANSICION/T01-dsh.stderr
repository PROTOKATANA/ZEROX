#### aplicar!

Let me write carefully.

```julia
function aplicar(E::Estado, B::Bloque, P::Params)
    E2 = clonar(E)
    r = aplicar!(E2, B, P)
    r === nothing ? E2 : r
end
```

`aplicar!` returns `Union{Nothing, Err}`.

```julia
function aplicar!(E::Estado, B::Bloque, P::Params)
    # ---- (a) forma y familia ----
    if B.familia == Genesis
        return aplicar_genesis!(E, B, P)
    end
    if E.fase == FaseGenesis
        return ErrGenesis
    end
    if B.familia == PoW
        return aplicar_pow!(E, B, P)
    else
        return aplicar_post!(E, B, P)
    end
end
```

`aplicar_genesis!`:
```julia
function aplicar_genesis!(E, B, P)
    (E.fase == FaseGenesis) || return ErrGenesis
    (B.padre == 0 && B.altura == 0) || return ErrGenesis
    # no txs or a single coinbase of value 0 whose outputs don't enter UTXO
    if !isempty(B.txs)
        (length(B.txs) == 1 && B.txs[1].tipo == TxCoinbase) || return ErrGenesis
        for o in B.txs[1].salidas
            o.valor == 0 || return ErrGenesis
        end
    end
    E.fase = FasePoW
    E.terminal = -1
    E.altura = 0
    E.trabajo_acum = 0
    E.slot = 0
    E.s0 = 0
    E.bloque_raiz = B.id
    return nothing
end
```

