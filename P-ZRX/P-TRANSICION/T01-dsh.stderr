Let me define helper `consumir_entradas!(E, entradas, firmante, P, punto)`:
```
function consumir_entradas!(E, entradas, firmante, P, punto)
    total = UInt64(0)
    for id in entradas
        o = get(E.utxo, id, nothing)
        o === nothing && return (ErrDobleGasto, UInt64(0))
        o.dueño == firmante || return (ErrAutorizacion, UInt64(0))
        g = gastable(E, o, P, punto)
        g isa Err && return (g, UInt64(0))
        g == false && return (ErrInmaduro, UInt64(0))
        r = suma_monetaria(total, o.valor)
        r isa Err && return (r, UInt64(0))
        total = r
    end
    # all good: remove them
    for id in entradas
        delete!(E.utxo, id)
    end
    return (nothing, total)
end
```
But if the same id appears twice in `entradas`, the first delete removes it, and the second lookup... but we do all lookups first, so duplicates would sum twice and then delete twice. I should check for duplicates. Let me check `length(unique(entradas)) == length(entradas)` else ErrDobleGasto. Add that.

Return type: tuple (Union{Err,Nothing}, UInt64). Fine.

`gastable(E,o,P,punto)` returns Bool or Err? It's pure; return Bool. But for coinbase, if not mature → false (caller maps to ErrInmaduro).

```
function gastable(E, o, P, punto)
    if o.origen == OrigenCoinbasePow
        if E.fase == FasePoW
            return punto >= o.creada_en_altura + P.M_cb
        else
            if o.creada_en_altura + P.M_cb <= E.altura_terminal
                return true
            end
            return punto >= E.s0 + P.M_res_slots
        end
    end
    return true
end
```

Hmm, wait: for a transfer in PoW that spends a coinbase output, `E.fase == FasePoW`, punto = B.altura. Good. For a transfer in PoST, punto = B.slot. Good.

But there's a catch: for the transition block, `E.fase` was set to FasePoST before applying txs. Good.

