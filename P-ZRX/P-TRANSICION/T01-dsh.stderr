**X-16 (order independence)**:
```julia
function test_X16(P)
    rng = StableRNG(0x1600 + hash(P) % 1000)
    bloques = historia_pequena(rng, P)  # ≤6 blocks
    ref = seleccionar(bloques, P)
    ref.punta == -1 && return true
    n = length(bloques)
    perms = n <= 7 ? collect(permutations(1:n)) : [randperm(rng, n) for _ in 1:200]
    refhash = hash_canonico(ref.estado)
    for perm in perms
        sec = bloques[collect(perm)]
        tip, E = nodo_en_linea(sec, P)
        (tip == ref.punta && hash_canonico(E) == refhash) || return false
    end
    return true
end
```
