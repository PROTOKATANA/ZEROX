```
function ==(l::AbstractDict, r::AbstractDict)
    if length(l) != length(r)
        return false
    end
    for pair in l
        if !haskey(r, pair.first)
            return false
        end
        if !isequal(pair.second, r[pair.first])
            return false
        end
    end
    return true
end
```
It uses `isequal`, not `==`. So if I define `==` but not `isequal`, Dict comparison would use the default `isequal` which for structs is `===` (field recursive? Actually `isequal` falls back to `==`, and `==` falls back to `===`). For mutable structs, `===` is identity, so two different Dict entries with equal content would not be `isequal`. So I need to define `Base.isequal` for the structs too (or make them immutable isbits-ish). 

