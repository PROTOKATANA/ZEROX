function aplicar_retiro!(E,B,P,punto,tx)
    tx.firmante == tx.clave || return ErrAutorizacion
    g = obtener_garantia!(E, tx.clave)
    tx.importe <= g.activo || return ErrSaldo
    isempty(g.en_retirada) || return ErrRetiroPendiente   # AMBIGUEDAD-2
    g.activo -= tx.importe
    inicio = E.fase == FasePoW ? E.s0 : B.slot
    push!(g.en_retirada, EnRetirada(tx.importe, inicio))
    return nothing
end
```
Note `g.activo -= tx.importe` is safe since importe ≤ activo. But the order wants checked_sub. Since we checked ≤, plain subtraction is safe. I'll add a comment. Actually let me use checked to honor §3.5:
