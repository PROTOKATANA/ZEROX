```
function construir_validos(gen, por_id, P)
    memo = Dict{Int,Estado}()
    E0 = estado_inicial(P)
    r = aplicar(E0, gen, P)
    r isa Err && return memo
    memo[gen.id] = r
    # iterate until no changes (since tree, one pass in BFS order)
    cola = [gen.id]
    while !isempty(cola)
        id = popfirst!(cola)
        Epadre = memo[id]
        # children
        for (bid,b) in por_id
            if b.padre == id && !haskey(memo,bid)
                r2 = aplicar(Epadre, b, P)
                if !(r2 isa Err)
                    memo[bid] = r2
                    push!(cola, bid)
                end
            end
        end
    end
    return memo
end
```

But this loops over all blocks for each id → O(n^2), fine for n≤12. But careful: a child whose parent is invalid is never in memo, so never processed. Good.

