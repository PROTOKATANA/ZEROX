function puntas_validas(memo, por_id)
    padres = Set{Int}()
    for id in keys(memo)
        b = por_id[id]
        b.padre != 0 && push!(padres, b.padre)
    end
    return [id for id in keys(memo) if !(id in padres)]
end
```

