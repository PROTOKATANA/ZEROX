```julia
using Test
using Transicion
using StableRNGs
using Combinatorics

const REJILLA = Symbol(get(ENV, "T01_REJILLA", "reducida"))
const PASO_REJ = parse(Int, get(ENV, "T01_PASO_REJ", "1"))
const PASO_EQ = parse(Int, get(ENV, "T01_PASO_EQ", "37"))
const REPLICAS = parse(Int, get(ENV, "T01_REPLICAS", "5"))

puntos_rej() = puntos_rejilla(rejilla=REJILLA)[1:PASO_REJ:end]
puntos_eq() = puntos_rejilla(rejilla=REJILLA)[1:PASO_EQ:end]

# ---- X-01 … X-15 ----
@testset "X-01…X-15 rechazos" begin
    res = Dict{String,Vector{Bool}}()
    fallos = String[]
    for P in puntos_rej()
        for c in escenarios_rechazo(P)
            r = aplicar(c.padre, c.B, P)
            ok = (r isa Err) && (r == c.esperado)
            if startswith(c.nombre, "X-11") || c.nombre == "X-12"
                ok = ok && !es_terminal(c.historial, P)
            end
            push!(get!(res, c.nombre, Bool[]), ok)
            ok || length(fallos) < 20 && push!(fallos, "$(c.nombre) P=$(P) r=$r")
        end
    end
    for n in sort(collect(keys(res)))
        @testset "$n" begin
            @test all(res[n])
        end
    end
    isempty(fallos) || @info "fallos" fallos
end
```

