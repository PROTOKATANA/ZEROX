Let me write:

```julia
function construir_poW(rng, P; hasta=10, parar_terminal=true, depositar=true,
                       alta_en=-1, prueba_en=-1, trabajo=1, transferir=false,
                       retirar_en=-1)
    bloques = Bloque[genesis_bloque()]
    E = aplicar(estado_inicial(P), bloques[1], P)
    estados = Estado[E]
    next_id = 2
    out_id = 1000
    sid = 1
    prod = 1
    for h in 1:hasta
        txs = Tx[]
        # coinbase
        if h == 1
            push!(txs, TxCoinbase([Salida(out_id, UInt64(5), 1, OrigenTx, -1, -1),
                                   Salida(out_id+1, UInt64(5), 2, OrigenTx, -1, -1)]))
            out_id += 2
        else
            push!(txs, TxCoinbase([Salida(out_id, UInt64(10), prod, OrigenTx, -1, -1)]))
            out_id += 1
        end
        txs_ok = copy(txs)
        Ebase = E
        # apply coinbase
        Bcb = mk_pow(id=next_id, padre=bloques[end].id, altura=h, txs=txs_ok, trabajo=trabajo)
        r = aplicar(Ebase, Bcb, P)
        r isa Err && error("coinbase inválida h=$h: $r")
        Et = r
        # local helper
        function intentar(cand)
            push!(txs_ok, cand)
            Bx = mk_pow(id=next_id, padre=bloques[end].id, altura=h, txs=txs_ok, trabajo=trabajo)
            rr = aplicar(Ebase, Bx, P)
            rr isa Err && (pop!(txs_ok); return nothing)
            return rr
        end
        # deposits
        ...
        # alta/prueba sector
        if P.sec == SECA && h == alta_en && h >= P.H_dep
            r2 = intentar(TxAltaSector(sid, prod, prod))
            r2 !== nothing && (Et = r2)
        end
        if P.sec == SECA && h == prueba_en
            r2 = intentar(TxPruebaSector(sid, prod))
            r2 !== nothing && (Et = r2)
        end
        # retiro
        if h == retirar_en
            g = get(Et.garantias, prod, nothing)
            if g !== nothing && g.activo >= UInt64(P.q)
                r2 = intentar(TxRetiro(prod, 1, prod))
                r2 !== nothing && (Et = r2)
            end
        end
        # transfer
        ...
        B = mk_pow(...)
        r = aplicar(Ebase, B, P)
        r isa Err && error(...)
        E = r
        push!(bloques, B); push!(estados, E)
        next_id += 1
        (parar_terminal && E.terminal == B.id) && break
    end
    return bloques, estados, next_id, out_id, prod
end
```

