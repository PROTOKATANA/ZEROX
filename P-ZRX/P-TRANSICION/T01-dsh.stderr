function aplicar_transferencia!(E,P,punto,tx)
    r, total = consumir_entradas!(E, tx.entradas, tx.firmante, P, punto)
    r isa Err && return r
    # create outputs
    for s in tx.salidas
        haskey(E.utxo, s.id) && return ErrDobleGasto
    end
    for s in tx.salidas
        E.utxo[s.id] = Salida(s.id, s.valor, s.dueño, OrigenTx, E.fase==FasePoW ? punto : -1, E.fase==FasePoST ? punto : -1)
    end
    # also check duplicate ids within salidas
    return nothing
end
```
