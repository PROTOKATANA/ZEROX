For spendability:
```
function gastable(E::Estado, o::Salida, P::Params)::Union{Bool,Err}
    if o.origen == OrigenCoinbasePow
        if E.fase == FasePoW
            return E.altura >= o.creada_en_altura + P.M_cb
        else # PoST
            if o.creada_en_altura + P.M_cb <= E.altura_terminal
                return true
            else
                return E.slot >= E.s0 + P.M_res_slots
            end
        end
    end
    return true
end
```
Wait, in PoST, `E.slot` is the parent's slot during `aplicar!` — for a transfer inside a block at slot B.slot, we haven't updated E.slot yet. So the spendability check would use the parent's slot, not B.slot. Bug. I need to pass the application point explicitly.

