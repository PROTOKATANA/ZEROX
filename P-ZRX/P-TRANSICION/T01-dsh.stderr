function backbone_poW(rng, P; id0=2)
    bloques = Bloque[]
    E = estado_inicial(P)
    g = genesis(1); push!(bloques,g); E = aplicar(E,g,P)
    next_id = Ref(id0)
    out_id = Ref(1000)   # output ids
    # key plan: keys 1 and 2
    # We'll create coinbase outputs and deposit them.
    # sector plan for SEC-A
    h = 0
    sector_alta = false; sector_probado = false
    sector_id = 1
    terminal = -1
    while h < 10
        h += 1
        txs = Tx[]
        # coinbase: at h==1, split 10 into 5+5 to keys 1,2; else 10 to key prod
        ...
        # deposits from matured coinbase outputs
        ...
        # sector alta/prueba
        ...
        B = Bloque(id=next_id[], familia=PoW, padre=(isempty(bloques) ? 0 : bloques[end].id), altura=h, trabajo=1, txs=txs)
        r = aplicar(E, B, P)
        if r isa Err
            # try to fix by dropping optional txs
            ...
        end
        E = r; push!(bloques, B); next_id[]+=1
        if E.terminal == B.id
            terminal = B.id; break
        end
    end
    return bloques, E, terminal, next_id, out_id
end
```

