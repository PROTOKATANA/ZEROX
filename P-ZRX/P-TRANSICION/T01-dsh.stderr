function es_terminal(hist, P)
    isempty(hist) && return false
    E = estado_inicial(P)
    terminal_encontrado = -1
    for (i,B) in enumerate(hist)
        E2 = clonar(E)
        # apply family/shape checks loosely
        if B.familia == Genesis
            r = aplicar_genesis!(E2,B,P); r isa Err && return false
        elseif B.familia == PoW
            # promotions + txs, ignoring TRN-05
            if E2.fase != FasePoW; return false; end
            r = promover!(E2, B.altura, false); r isa Err && return false
            r = aplicar_txs!(E2, B, P); r isa Err && return false
            E2.trabajo_acum += B.trabajo
            E2.altura = B.altura
            if terminal_encontrado == -1 && es_terminal_condiciones(E2,B,P)
                terminal_encontrado = B.id
            end
        else
            # PoST
            ...
        end
        E = E2
    end
    return terminal_encontrado == hist[end].id
end
```
