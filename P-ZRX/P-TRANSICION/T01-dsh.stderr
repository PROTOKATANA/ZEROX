function seleccionar(bloques::Vector{Bloque}, P::Params)
    # map id -> bloque
    por_id = Dict{Int,Bloque}()
    for b in bloques; por_id[b.id]=b; end
    # find genesis
    gen = nothing
    for b in bloques
        if b.familia == Genesis; gen = b; break; end
    end
    gen === nothing && return nothing
    # memo states
    memo = Dict{Int,Estado}()
    E0 = estado_inicial(P)
    r = aplicar(E0, gen, P)
    r isa Err && return nothing
    memo[gen.id] = r
    # iterative post-order to compute valid states
    # returns list of valid tips
    ...
end
```

