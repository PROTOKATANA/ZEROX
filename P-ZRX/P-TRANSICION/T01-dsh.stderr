Let me write `aplicar_txs!` to return `Union{Nothing,Err}` and internally compute tarifas and coinbase.

```
function aplicar_txs!(E, B, P, punto)
    # order: coinbase first
    txs = B.txs
    # count coinbases
    ncb = count(t -> t.tipo == TxCoinbase || t.tipo == TxCoinbasePost, txs)
    ncb > 1 && return ErrEmision
    tarifas = Int128(0)
    coinbase_pagada = UInt64(0)
    # coinbase first
    orden = Vector{Tx}(undef, length(txs))
    # Actually just iterate: first the coinbase (if any), then the rest
    if ncb == 1
        idx = findfirst(t -> t.tipo == TxCoinbase || t.tipo == TxCoinbasePost, txs)
        orden = vcat([txs[idx]], txs[1:idx-1], txs[idx+1:end])
    else
        orden = txs
    end
    for tx in orden
        if tx.tipo == TxTransferencia
            ve = Int128(0)
            for id in tx.entradas
                o = get(E.utxo, id, nothing)
                o === nothing && return ErrDobleGasto
                ve += Int128(o.valor)
            end
            vs = Int128(0)
            for s in tx.salidas; vs += Int128(s.valor); end
            vs <= ve || return ErrSaldo   # AMBIGUEDAD-3
            tarifas += ve - vs
            r = aplicar_transferencia!(E, B, P, punto, tx)
            r isa Err && return r
        else
            r = aplicar_tx!(E, B, P, punto, tx)
            r isa Err && return r
            if tx.tipo == TxCoinbase
                for s in tx.salidas
                    r2 = suma_monetaria(coinbase_pagada, s.valor)
                    r2 isa Err && return r2
                    coinbase_pagada = r2
                end
            elseif tx.tipo == TxCoinbasePost
                coinbase_pagada = tx.importe
            end
        end
    end
    subsidio = B.familia == PoW ? subsidio_pow(B.altura, P) : subsidio_post(B.slot, P)
    limite = Int128(subsidio) + tarifas
    Int128(coinbase_pagada) <= limite || return ErrEmision
    E.emitido += Int128(coinbase_pagada) - tarifas
    E.subsidio_acum += Int128(subsidio)
    return nothing
end
```

Wait, but if a Transferencia appears and `vs > ve`, I return ErrSaldo before applying. Good. But what if the transfer's inputs are invalid (missing)? The `get` returns nothing → ErrDobleGasto. Good.

