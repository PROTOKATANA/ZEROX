Let me write seleccion.jl:

```julia
# Selección transversal y Corte.

struct ResultadoSeleccion
    punta::Int
    estado::Estado
    validos::Dict{Int,Estado}
end

function construir_validos(bloques::Vector{Bloque}, P::Params)
    por_id = Dict{Int,Bloque}()
    for b in bloques
        por_id[b.id] = b
    end
    # genesis
    gen = nothing
    for b in bloques
        if b.familia == Genesis
            gen = b
            break
        end
    end
    memo = Dict{Int,Estado}()
    gen === nothing && return memo, por_id
    E0 = estado_inicial(P)
    r = aplicar(E0, gen, P)
    r isa Err && return memo, por_id
    memo[gen.id] = r
    cola = [gen.id]
    while !isempty(cola)
        pid = popfirst!(cola)
        Ep = memo[pid]
        for b in bloques
            if b.padre == pid && !haskey(memo, b.id)
                r2 = aplicar(Ep, b, P)
                if !(r2 isa Err)
                    memo[b.id] = r2
                    push!(cola, b.id)
                end
            end
        end
    end
    return memo, por_id
end
```

Wait — a subtle issue: a block whose parent is valid but that fails applying is invalid; its descendants also invalid. Since we only enqueue valid blocks, descendants of invalid blocks never get a valid parent in memo, so they're skipped. Good.

But there's a bug: `b.padre == pid` and `!haskey(memo,b.id)`. If a block has parent pid and is invalid, we don't add it. Later, if the same block appears again? No, blocks are unique by id. Fine.

