```
function nodo_en_linea(secuencia::Vector{Bloque}, P::Params)
    # store blocks
    buf = Bloque[]
    tip = -1
    estado_tip = nothing
    for b in secuencia
        push!(buf, b)
        # recompute best
        res = seleccionar_estado(buf, P)   # returns (tip, E) or nothing
        res === nothing && continue
        best, Ebest = res
        if tip == -1
            tip = best; estado_tip = Ebest
        else
            # C-FIN-01
            d = slot_de(estado_tip) - slot_ancestro_comun(...)
            if d >= P.F_slots
                # keep current
            else
                tip = best; estado_tip = Ebest
            end
        end
    end
    return tip, estado_tip
end
```

Hmm, computing the common ancestor requires parent pointers. The states don't store the full history. I need the chain from genesis to a tip. Let me store the block map and compute ancestors via parent pointers. `buf` has all received blocks. To find the common ancestor of `tip` and `best`:
```
function ancestro_comun(a, b, por_id)
    # depths
    ca = cadena_hasta(a, por_id)  # vector of ids from genesis
    cb = cadena_hasta(b, por_id)
    i = 1
    while i <= min(length(ca),length(cb)) && ca[i]==cb[i]
        i+=1
    end
    return ca[i-1]
end
```
