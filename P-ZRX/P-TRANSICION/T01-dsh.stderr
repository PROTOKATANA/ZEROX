```
function generar_valida(rng, P)
    bloques = Bloque[]
    next_id = Ref(1)
    g = Bloque(id=next_id[], familia=Genesis, ...)
    push!(bloques, g); next_id[] += 1
    E = aplicar(estado_inicial(P), g, P)
    # choose producer
    prod = 1
    # accumulate coinbase outputs
    h = 0
    terminal_id = -1
    target_altura = P.H_corte_min + 1  # ensure we go past
    # We'll build PoW blocks until terminal or max
    while h < 8
        h += 1
        # available coinbase outputs
        maduras = [o for (_,o) in E.utxo if o.origen==OrigenCoinbasePow && h >= o.creada_en_altura + P.M_cb]
        # group
        txs = Tx[]
        # coinbase: value 10 to prod (or split)
        # choose outputs of 10 to prod
        cb = CoinbaseTx([Salida(next_id...)...])
        push!(txs, cb)
        # deposits: if h >= H_dep, deposit matured outputs to prod key
        ...
        # sector alta/proof in SEC-A
        ...
        B = Bloque(...)
        r = aplicar(E,B,P)
        if r isa Err
            # drop the offending optional txs and retry, or just skip block
            ...
        else
            E = r
            push!(bloques, B)
            if E.terminal == B.id
                terminal_id = B.id
                break
            end
        end
    end
    # PoST blocks
    ...
end
```

