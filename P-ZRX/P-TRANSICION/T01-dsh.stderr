```julia
function extender_post!(bloques, E, next_id, prod, P; n=rand(...))
    # E is the terminal's state
    snap = E  # after terminal
    parent = bloques[end].id
    slot = 0
    for i in 1:n
        slot += rand(1:2)
        B = Bloque(id=next_id, familia=PoST, padre=parent, slot=slot, productor=prod, peso=1, sector=(P.sec==SECA ? 1 : 0), txs=[TxCoinbasePost(3)])
        r = aplicar(E, B, P)
        if r isa Err
            break
        end
        E = r
        push!(bloques, B)
        parent = B.id
        next_id += 1
    end
    return bloques, E, next_id
end
```

