Plan for base:
```julia
function cargar(path)
    d = Dict{Int,String}()
    n = 0; buf = IOBuffer(); en = false
    for l in eachline(path)
        if startswith(l, "CASO ")
            n = parse(Int, split(split(l, " ")[2], "=")[2])
            buf = IOBuffer(); en = true
        end
        en && println(buf, l)
        if l == "FIN"
            d[n] = String(take!(buf)); en = false
        end
    end
    d
end
a = cargar("resultados/vectores-transicion-v0.1.txt")
b = cargar("resultados/vectores-transicion-v0.2.txt")
println("v0.1 casos=", length(a), " v0.2 casos=", length(b))
solo1 = setdiff(keys(a), keys(b)); solo2 = setdiff(keys(b), keys(a))
println("solo v0.1=", length(solo1), " solo v0.2=", length(solo2))
dif = [k for k in intersect(keys(a), keys(b)) if a[k] != b[k]]
println("casos distintos=", length(dif))
# categorizar: casos donde difieren líneas RES / SEL / UTXO / GAR / EST
function lineas(s, pref) = [l for l in split(s, '\n') if startswith(l, pref)]
cres = count(k -> lineas(a[k], "RES") != lineas(b[k], "RES"), dif)
csel = count(k -> lineas(a[k], "SEL") != lineas(b[k], "SEL"), dif)
cutxo = count(k -> lineas(a[k], "UTXO") != lineas(b[k], "UTXO"), dif)
cgar = count(k -> lineas(a[k], "GAR") != lineas(b[k], "GAR"), dif)
cest = count(k -> lineas(a[k], "EST") != lineas(b[k], "EST"), dif)
println("de los distintos: RES=", cres, " SEL=", csel, " UTXO=", cutxo, " GAR=", cgar, " EST=", cest)
# nombres de los casos distintos? no se guardan; extraer de v0.2
```
