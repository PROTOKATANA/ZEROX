```julia
# Prefijo PoW con garantía activa para la clave 1 y (opcional) un retiro
# aplicado. Devuelve (bloques, estados).
function _prefijo_nonce_pow(P::Params; seed::Int = 1, hasta::Int = 6,
                            depositar::Bool = true, retirar_en::Int = -1,
                            dos_salidas::Bool = false)
    rng = StableRNG(seed)
    bloques = Bloque[genesis_bloque()]
    E = aplicar(estado_inicial(P), bloques[1], P)
    E isa Err && return bloques, Estado[E]
    estados = Estado[E]
    next_id = 2
    out_id = 1500
    for h in 1:hasta
        txs = Tx[]
        # coinbase: dos salidas de 5 a la clave 1 si dos_salidas, si no salida 10
        if dos_salidas
            push!(txs, tx_coinbase([Salida(out_id, UInt64(5), 1, OrigenTx, -1, -1),
                                    Salida(out_id+1, UInt64(5), 1, OrigenTx, -1, -1)]))
            out_id += 2
        else
            push!(txs, tx_coinbase([Salida(out_id, UInt64(10), 1, OrigenTx, -1, -1)]))
            out_id += 1
        end
        txs_ok = copy(txs)
        Ebase = E
        Et = aplicar(Ebase, gen_pow(id=next_id, padre=bloques[end].id, altura=h, txs=txs_ok), P)
        ...
```

