```julia
function casos_nonce_pow(P::Params; seeds = 1:16)
    out = CasoNegativo[]
    Hpre = max(P.H_corte_min - 1, 1)
    for seed in seeds
        # (a) prefijo con depósitos y un retiro aplicado en el último bloque PoW
        bloques, estados, next_id, _, _ = construir_poW(
            StableRNG(seed), P; hasta = Hpre, depositar = true,
            transferir = false, retirar_en = Hpre)
        E = estados[end]
        if E.terminal == -1
            Bk = gen_pow(id = next_id, padre = bloques[end].id,
                         altura = E.altura + 1, txs = Tx[])
            append!(out, casos_nonce_bloque(P, bloques, E, Bk))
        end
        # (b) prefijo sin depósitos y con varias salidas de la clave 1: dos
        #     depósitos de la misma clave en un bloque PoW.
        bloquesb, estadosb, next_idb, _, _ = construir_poW(
            StableRNG(1000 + seed), P; hasta = Hpre, depositar = false,
            transferir = false, claves_extra = [1])
        Eb = estadosb[end]
        if Eb.terminal == -1
            Bk = gen_pow(id = next_idb, padre = bloquesb[end].id,
                         altura = Eb.altura + 1, txs = Tx[])
            append!(out, casos_nonce_bloque(P, bloquesb, Eb, Bk))
        end
    end
    return out
end
```

