Let me define the counting logic matching my planned generator:
For each chain (seed), for each k in 2:length(bloques):
  Ep = estados[k-1]; Bk = bloques[k]; pref = bloques[1:k-1]
  es_pow = Bk.familia == PoW
  fase = es_pow ? FasePoW : FasePoST
  pt = punto_bloque_neg(Ep, Bk)
  Ef = estado_promovido(Ep, P, fase, pt)
  prod_ok = activo_de(Ef,1) >= q
  aplica_tx = es_pow || prod_ok
  if !aplica_tx: continue
  # rep-retiro: count retiros in pref
  retiros = [tx for b in pref for tx in b.txs if tx.tipo==TxRetiro]
  # rep-liberacion
  liberaciones = [tx for b in pref for tx in b.txs if tx.tipo==TxLiberacion]
  # saltado: keys with activo>=1 and empty en_retirada
  # viejo: keys with nonce>0
