```julia
function _prefijos_pow_nonce(P::Params; seeds = 1:16)
    res = Tuple{Vector{Bloque},Estado,Int}[]
    Hpre = max(P.H_corte_min - 1, 1)
    for seed in seeds
        for (dep, claves) in ((true, Int[]), (false, [1]))
            r = construir_poW(StableRNG(dep ? seed : 1000 + seed), P;
                              hasta = Hpre, depositar = dep,
                              transferir = false,
                              retirar_en = dep ? Hpre : -1,
                              claves_extra = claves)
            E = r[2][end]
            E.terminal == -1 && push!(res, (r[1], E, r[3]))
        end
    end
    return res
end
```

