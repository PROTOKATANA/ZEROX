Solution: augment `casos_nonce` to also build a "PoW continuation" prefix that stops before terminal, then call `casos_nonce_bloque` with a synthetic `Bk` (the next PoW block). Let me implement a dedicated function:

```julia
function casos_nonce_pow_preterminal(P::Params; seeds = 1:12)
    out = CasoNegativo[]
    for seed in seeds
        # prefijo que no alcanza el terminal
        bloques, estados, next_id, out_id, prod = construir_poW(
            StableRNG(seed), P; hasta = max(P.H_corte_min - 1, 1),
            depositar = true, transferir = false,
            retirar_en = max(P.H_corte_min - 1, 1))
        E = estados[end]
        E.terminal == -1 || continue
        pref = bloques
        # un bloque PoW "plantilla" sobre E
        Bk = gen_pow(id = next_id, padre = bloques[end].id,
                     altura = E.altura + 1, txs = Tx[])
        append!(out, casos_nonce_bloque(P, pref, E, Bk))
    end
    return out
end
```

