```julia
function _err_neg(bloques, P)
    memo, por_id = construir_validos(bloques, P)
    B = last(bloques)
    Ep = get(memo, B.padre, nothing)
    Ep === nothing && return :sinpadre
    r = aplicar(Ep, B, P)
    return r isa Err ? r : :ok
end
```
