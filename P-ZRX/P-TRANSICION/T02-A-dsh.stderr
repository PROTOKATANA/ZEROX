```
function e1_replica!(rng, z, h)
    z == 0 && return true
    q = h; p = 1-h
    q >= p && return true
    x = 0; honest = 0
    while honest < z
        if rand(rng) < q; x += 1; else; honest += 1; end
    end
    x >= z && return true
    d = z - x
    @inbounds while d > 0
        if rand(rng) < q; d -= 1; else; d += 1; end
        d > CAP_GR && return false
    end
    return true
end
```
CAP_GR = 500.

