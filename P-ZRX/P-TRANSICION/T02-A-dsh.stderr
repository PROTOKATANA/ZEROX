```
function e2_replica!(rng,h,a,k,r,p,Fs,M)
    th = gamma_erlang!(rng,k,1-h)
    horizonT = th + M*r
    ta=0.0; na=0
    while na<k
        ta += -log(rand(rng))/h
        ta > horizonT && return (false,false,false,false,NaN,na)
        na+=1
    end
    α=(1-a)*p; β=a*p
    ge=gt=false; ge_on=gt_on=false; slots_ge=NaN
    dlast=0; WH=0; WA=0
    if ta <= th
        # state at t_A
        ge=true; ge_on=(0.0<Fs); slots_ge=(ta-th)/r
        D=0
        # next event times
        tHn = th + r; tAn = ta + r
        jH=1
    else
        m = floor(Int,(ta-th)/r)
        wh, dl = estado_honesto!(rng,m,α)
        WH=wh; dlast=dl; D=wh
        if wh==0
            ge=true; ge_on=(0.0<Fs); slots_ge=(ta-th)/r
        end
        tHn = th + (m+1)*r; tAn = ta + r
        jH = m+1
    end
    # horizon bound
    tend = horizonT
    while true
        tnext = min(tHn,tAn)
        tnext > tend && break
        if tHn <= tAn
            if rand(rng) < α
                WH += 1; D += 1; dlast = jH
            end
            jH += 1; tHn = th + jH*r
        else
            if rand(rng) < β
                WA += 1; D -= 1
            end
            if !ge && WA >= WH
                ge=true; ge_on=(dlast<Fs); slots_ge=(tnext-th)/r
            end
            if !gt && WA > WH
                gt=true; gt_on=(dlast<Fs); break
            end
            tAn += r
        end
        if a < 0.5 && D > DCAP_E2
            break
        end
    end
    return (ge,ge_on,gt,gt_on,slots_ge,k)
end
```
Wait, there's a bug: for the `tHn <= tAn` branch, I don't check the win after the honest block (honest increases WH, can't cause a win). Correct. For the adversary branch, I check. Good.

But the ordering when tHn == tAn: I process honest first (tHn <= tAn branch), then next iteration tAn < tHn? After processing honest, tHn advances by r, so tAn (unchanged) < tHn, so next iteration processes adversary. That's correct: honest slot at the same time as adversary slot — both occur; ordering irrelevant for counts but we process honest then adversary. Good.

For tau<=0: tHn = th+r (the first honest slot after th), tAn = ta+r. Since ta<=th, tAn could be ≤ tHn or >. Fine.

The initial ge for tau<=0 is set. Good.

The DCAP early break: if D>DCAP and a<0.5, break (fail for gt). But ge might already be true. Return (ge,ge_on,false,false,slots_ge,k). Good.

The `estado_honesto!` uses Binomial(dlast-1,α) which is O(1) but calls Distributions. For m large and a<0.5, we might early-break after sampling; fine.

