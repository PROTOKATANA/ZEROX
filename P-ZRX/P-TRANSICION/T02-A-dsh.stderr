```
function e2_replica!(rng, h, a, k, r, p, Fs, M)
    # sample t_H
    th = 0.0
    @inbounds for _ in 1:k
        th += -log(rand(rng))
    end
    th /= (1-h)
    horizonT = th + M*r
    # simulate adversary arrivals until k or exceed horizonT
    ta = 0.0
    na = 0
    while na < k
        ta += -log(rand(rng))/h
        if ta > horizonT
            return (false,false,0.0,na,0)
        end
        na += 1
    end
    # now ta reached k blocks (na==k)
    alpha=(1-a)*p; beta=a*p
    if ta <= th
        online = 0.0 < Fs
        return (true,online,(ta-th)/r,k,0)   # slots rel t_H (<=0)
    end
    m = floor(Int,(ta-th)/r)
    D=0; dlast=0
    @inbounds for j in 1:m
        if rand(rng)<alpha
            D+=1; dlast=j
        end
    end
    if D==0
        return (true,true,(ta-th)/r,k,m)   # win at t_A, d=0
    end
    i=0
    while true
        i+=1
        tai = ta + i*r
        if tai > horizonT
            return (false,false,0.0,k,0)
        end
        j=m+i
        if rand(rng)<alpha
            D+=1; dlast=j
        end
        if rand(rng)<beta
            D-=1
        end
        if D<=0
            online = dlast < Fs
            return (true,online,tai/r,k,dlast)
        end
    end
end
```
