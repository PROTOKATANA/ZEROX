```
function e3_replica!(rng,h,a,k,delta,r,p,Fs)
    rate = h/(1+delta)
    ta = gamma_erlang!(rng,k,rate)
    n = floor(Int, ta/r)
    α = (1-a)*p
    # honest blocks in slots 1..n
    # fc1 partition: last slot >= Fs
    if isinf(Fs) || n < Fs
        part = false
    else
        # P(at least one block in slots Fs..n)
        cnt = rand(rng, Binomial(n - Int(Fs) + 1, α))
        part = cnt > 0
    end
    # fc3: W_H == 0
    cnt0 = n>0 ? rand(rng, Binomial(n, α)) : 0
    fc3 = cnt0 == 0
    return (part, fc3, ta)
end
```
