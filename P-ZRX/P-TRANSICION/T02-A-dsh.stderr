One more consideration: threads and RNG. LINEO: `StableRNG(master + replica)` but also need point id to avoid correlated streams across points. I'll use a mixing function. StableRNG accepts an integer seed. I'll create:
```
function semilla_replica(master::UInt64, esc::Int, punto::Int, rep::Int)
    x = master
    x = x ⊻ (UInt64(esc) * 0x9e3779b97f4a7c15)
    x = x ⊻ (UInt64(punto) * 0xc2b2ae3d27d4eb4f)
    x = x ⊻ (UInt64(rep) * 0x165667b19e3779f9)
    # splitmix64 finalizer
    x ⊻= x >> 30; x *= 0xbf58476d1ce4e5b9
    x ⊻= x >> 27; x *= 0x94d049bb133111eb
    x ⊻= x >> 31
    return x
end
```
Then `StableRNG(semilla)`.

For E4, each replica may need many random numbers; StableRNG is fine.

Now the driver:
```
function ejecutar_escenario(::E1, punto, nrep, master)
    res = Vector{Bool}(undef, nrep)  # or UInt8
    Threads.@threads for rep in 1:nrep
        rng = StableRNG(semilla_replica(master, 1, punto.id, rep))
        res[rep] = e1_replica!(rng, ...)
    end
    return res
end
