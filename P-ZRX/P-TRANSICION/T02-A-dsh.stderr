function puntos_e2()
    base=(h=0.25,a=0.4,k=6,r=0.1,p=0.9,Fs=1000.0)
    pts=PuntoE2[]; id=0
    add(;h=base.h,a=base.a,k=base.k,r=base.r,p=base.p,Fs=base.Fs) = (id+=1; push!(pts,PuntoE2(id,h,a,k,r,p,Fs)))
    for h in M.H_GRID; add(h=h); end
    for a in M.A_GRID
        if a>=0.5; add(a=a, Fs=100.0)  # keep M small
        else; add(a=a); end
    end
    for k in M.K_GRID; add(k=k); end
    for r in M.R_GRID; add(r=r); end
    for p in M.P_GRID; add(p=p); end
    for Fs in M.F_GRID
        add(Fs=Fs)   # base a=0.4<0.5
    end
    # interactions for the falsifiable question (a<1/2, h high)
    for h in (0.4,0.6,0.9), a in (0.25,0.4,0.45)
        add(h=h,a=a)
    end
    return pts
end
```
