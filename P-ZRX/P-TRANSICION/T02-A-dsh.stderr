```
function e2_replica!(rng, h,a,k,r,p,Fs,M)
    th = gamma_erlang!(rng,k,1-h)
    horizonT = th + M*r
    # adversary arrivals
    ta=0.0; na=0
    while na<k
        ta += -log(rand(rng))/h
        if ta > horizonT
            return ...
        end
        na+=1
    end
    alpha=(1-a)*p; beta=a*p
    # event merge: next honest slot time tH_next = th + jH*r; next adv slot tA_next = ta + jA*r
    jH=1; jA=1
    WH=0; WA=0
    tH_next=th+r; tA_next=ta+r
    dlast=0
    ge=false; gt=false; ge_online=false; gt_online=false
    slots_ge=NaN; slots_gt=NaN
    # initial check at t_A: WA=0, WH = number honest slots with time <= ta = floor(max(0,ta-th)/r)
    WH = ta>th ? floor(Int,(ta-th)/r) : 0
    # we must also account dlast for those honest blocks; but for the initial check,
    # if WH==0 then tie at t_A; if WH>0 no win.
    if WA>=WH
        ge=true; ge_online = 0 < Fs; slots_ge=0.0
        if WA>WH
            gt=true; gt_online=0<Fs; slots_gt=0.0
        end
    end
    # process events
    while !gt
        tnext = min(tH_next, tA_next)
        tnext > horizonT && break
        if tH_next <= tA_next
            # honest slot
            if rand(rng)<alpha
                WH+=1; dlast=jH
            end
            jH+=1; tH_next = th + jH*r
        else
            if rand(rng)<beta
                WA+=1
            end
            jA+=1; tA_next = ta + jA*r
        end
        if WA>=WH && !ge
            ge=true; ge_online = dlast < Fs; slots_ge = (tnext-th)/r
        end
        if WA>WH
            gt=true; gt_online = dlast < Fs; slots_gt=(tnext-th)/r
            break
        end
    end
    ...
end
```
