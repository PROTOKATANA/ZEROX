```
function e2_replica!(rng, h,a,k,r,p,Fs,M)
    th = 0.0
    @inbounds for _ in 1:k; th += -log(rand(rng)); end
    th /= (1-h)
    ta = 0.0
    @inbounds for _ in 1:k; ta += -log(rand(rng)); end
    ta /= h
    horizonT = th + M*r
    ta > horizonT && return (false,false,0.0,0,0)   # fail
    alpha = (1-a)*p; beta = a*p
    if ta <= th
        # win at t_A; d=0
        return (true, true, (ta-th)/r, k, trunc(Int, th/r))  # slots? 
    end
    # m honest slots before ta
    m = floor(Int, (ta - th)/r)
    D = 0
    dlast = 0
    @inbounds for j in 1:m
        if rand(rng) < alpha
            D += 1; dlast = j
        end
    end
    if D == 0
        return (true, true, (ta-th)/r, k, m)
    end
    i = 0
    # loop rounds
    while true
        i += 1
        tai = ta + i*r
        tai > horizonT && return (false,false,0.0,k,0)
        j = m + i
        if rand(rng) < alpha
            D += 1; dlast = j
        end
        if rand(rng) < beta
            D -= 1
        end
        if D <= 0
            online = dlast < Fs
            return (true, online, tai/r, k, dlast)   # slots from t_H
        end
    end
end
```
