```
function escribir_caso(io, n, nombre, punto, semilla, bloques, P)
    println(io, "CASO n=$n nombre=$nombre punto=$punto semilla=$semilla")
    println(io, render_param(P))
    resmap = res_por_bloque(bloques, P)
    for b in bloques
        println(io, render_bloque(b))
        for tx in b.txs
            println(io, render_tx(tx))
        end
        println(io, "RES bloque=$(b.id) res=$(resmap[b.id])")
    end
    sel = seleccionar(bloques, P)
    println(io, "SEL punta=$(sel.punta)")
    E = sel.estado
    for line in render_utxo(E); println(io, line); end
    for line in render_gar(E); println(io, line); end
    println(io, render_est(E))
    println(io, "FIN")
end
```

