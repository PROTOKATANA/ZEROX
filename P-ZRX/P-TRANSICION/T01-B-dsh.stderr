    # R-8: CoinbasePost y Liberación con importe 0 en PoST ⇒ ErrSaldo
    Ppost = Params(H_dep=1, M_cb=1, M_dep=0, H_corte_min=2, W_min=1, S_min=1,
                   K_min=1, q=1, M_res_slots=1, M_dep_slots=1, M_rec_slots=1,
                   R_slots=1, F_slots=typemax(Int), sec=SEC0)
    tpost = construir_poW(StableRNG(78), Ppost; hasta=10, depositar=true, transferir=false)
    ET = tpost[2][end]
    @test ET.terminal != -1
    if ET.terminal != -1
        T = tpost[1][end]
        BR8c = gen_post(id=T.id+1, padre=T.id, slot=1, productor=1, peso=1,
                        txs=[tx_coinbase_post(0)])
        @test aplicar(ET, BR8c, Ppost) == ErrSaldo
        BR8d = gen_post(id=T.id+1, padre=T.id, slot=1, productor=1, peso=1,
                        txs=[tx_coinbase_post(3), tx_liberacion(1, 0, 1)])
        @test aplicar(ET, BR8d, Ppost) == ErrSaldo
    end
end
```

