```julia
function casos_negativos(P; seeds = [707, 808, 909], max_post = 3)
    casos = CasoNegativo[]
    for seed in seeds
        base = cadena_base(P, seed; max_post = max_post)
        base === nothing && continue
        bloques, estados = base
        for k in 2:length(bloques)
            Ep = estados[k-1]
            Bk = bloques[k]
            pref = bloques[1:k-1]
            append!(casos, casos_bloque(P, pref, Ep, Bk))
            # G1: productores sin garantía
            append!(casos, casos_garantia_insuficiente(P, pref, Ep, Bk))
            # G2
            if Bk.familia == PoST
                append!(casos, casos_garantia_pendiente(P, pref, Ep, Bk))
            end
        end
    end
    return casos
end
```

`cadena_base`:
```julia
function cadena_base(P; seed, max_post = 3)
    retirar = 9 >= P.H_corte_min ? P.H_corte_min : -1
    tb = construir_poW(StableRNG(seed), P; hasta = 9, depositar = true,
                       transferir = false, retirar_en = retirar)
    bloques, estados = tb[1], tb[2]
    E = estados[end]
    if E.terminal != -1
        post = extender_post(StableRNG(seed + 1), P, bloques, estados, tb[3],
                             tb[4], tb[5]; max_post = max_post)
        bloques, estados = post[1], post[2]
    end
    return bloques, estados
end
```

Hmm, `construir_poW` with `retirar_en=H_corte_min`: at h==H_corte_min, the retiro is attempted only if `g.activo >= q`. For 4096, at h=7 deposit makes activo 14 >= 5. Good. For punto1, at h=2 activo 10 >= 1. Good. For seed variation, deposits may differ slightly, but should be fine.

