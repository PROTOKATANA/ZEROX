Let me define:

```julia
# --- utilidades ---
const ID_SALIDA_NEG = 900_000

function salida_neg(id, valor, dueño)
    Salida(id, UInt64(valor), dueño, OrigenTx, -1, -1)
end

punto_de(P, B) = B.familia == PoW ? B.altura : B.slot

# outputs spendable in Ep at the point of Bk
function gastables_en(Ep, P, Bk)
    pt = punto_de(P, Bk)
    os = Salida[]
    for (_, o) in Ep.utxo
        gastable(Ep, o, P, pt) && push!(os, o)
    end
    return sort(os, by = o -> o.id)
end

function inmaduros_en(Ep, P, Bk)
    pt = punto_de(P, Bk)
    os = Salida[]
    for (_, o) in Ep.utxo
        o.origen == OrigenCoinbasePow || continue
        gastable(Ep, o, P, pt) || push!(os, o)
    end
    return sort(os, by = o -> o.id)
end
```

Note: `gastable` uses `punto` and E.fase. For a PoW Bk, point = altura; for a PoST Bk, point = slot. But `gastable(Ep, o, P, pt)` uses `Ep.fase`; if Bk is a transition PoST block, Ep.fase is FasePoW, but the block will be applied in FasePoST. Hmm, `gastable_en` takes `fase` explicitly; `gastable(E, o, P, punto)` passes `E.fase`. For the transition block, the applicable phase is PoST but Ep.fase is PoW. The code in `aplicar_post!` sets `E.fase = FasePoST` BEFORE `aplicar_txs!`. So the correct maturity check is with fase=PoST. So for determining spendability for a transition block, I should use `gastable_en(o, FasePoST, Ep.altura_terminal, Ep.s0, P, pt)`. Let me make a helper `gastable_para(Ep, o, P, Bk)` that uses fase = (Bk.familia==PoST ? FasePoST : FasePoW). Actually more precisely, `aplicar_post!` sets fase to PoST for the transition block; for subsequent PoST blocks Ep.fase is already PoST. So:
```
function fase_de_aplicacion(Ep, Bk)
    Bk.familia == PoST ? FasePoST : FasePoW
end
gastable_para(Ep, o, P, Bk) = gastable_en(o, fase_de_aplicacion(Ep,Bk), Ep.altura_terminal, Ep.s0, P, punto_de(P,Bk))
```
Good.

