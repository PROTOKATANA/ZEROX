```julia
function bloque_neg(P, pref, Ep, Bk, txs; productor = 1, peso = 1)
    tip = last(pref).id
    idb = tip + 1
    if Bk.familia == PoW
        return gen_pow(id = idb, padre = tip, altura = Ep.altura + 1,
                       txs = txs, trabajo = 1, pow_ok = true)
    else
        slot = Ep.fase == FasePoW ? max(Ep.slot + 1, 1) : Ep.slot + 1
        return gen_post(id = idb, padre = tip, slot = slot, productor = productor,
                        peso = peso, sector = 0, txs = txs)
    end
end
```
