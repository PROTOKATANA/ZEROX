```julia
# T01-C — generadores de casos negativos de transacción.
# ... comments ...

const ID_NEG = 900_000

salida_neg(id, valor, dueño) = Salida(Int(id), UInt64(valor), Int(dueño), OrigenTx, -1, -1)

activo_de(E, k) = haskey(E.garantias, k) ? E.garantias[k].activo : UInt64(0)

function punto_neg(P, B)
    return B.familia == PoW ? B.altura : B.slot
end

function fase_aplicacion(Ep, Bk)
    return Bk.familia == PoST ? FasePoST : FasePoW
end

function gastable_neg(Ep, o, P, Bk)
    return gastable_en(o, fase_aplicacion(Ep, Bk), Ep.altura_terminal, Ep.s0, P,
                       punto_neg(P, Bk))
end

function gastables_neg(Ep, P, Bk)
    os = Salida[]
    for (_, o) in Ep.utxo
        gastable_neg(Ep, o, P, Bk) && push!(os, o)
    end
    return sort(os, by = o -> o.id)
end

function inmaduros_neg(Ep, P, Bk)
    os = Salida[]
    for (_, o) in Ep.utxo
        o.origen == OrigenCoinbasePow || continue
        gastable_neg(Ep, o, P, Bk) || push!(os, o)
    end
    return sort(os, by = o -> o.id)
end
```

