function bloque_pow_neg(id, padre, altura, txs)
    gen_pow(id = id, padre = padre, altura = altura, txs = txs, trabajo = 1, pow_ok = true)
end
function bloque_post_neg(id, padre, slot, txs; productor = 1, peso = 1, sector = 0)
    gen_post(id = id, padre = padre, slot = slot, productor = productor, peso = peso, sector = sector, txs = txs)
end
```
