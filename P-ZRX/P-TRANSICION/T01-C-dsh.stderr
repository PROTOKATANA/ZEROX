```julia
function casos_garantia_insuficiente(P, pref, Ep, Bk)
    Bk.familia == PoST || return CasoNegativo[]
    out = CasoNegativo[]
    for K in (3, 4, 5, 7, 9999)
        # solo si K no tiene garantía activa ni pendientes que maduren ahora
        activo_de(Ep, K) == 0 || continue
        # el bloque no procesa txs por el error de garantía
        B = bloque_neg(P, pref, Ep, Bk, [tx_coinbase_post(3)]; productor = K)
        push!(out, CasoNegativo("neg-garantia-sin-activo", ErrGarantia, "PoST",
                                "Garantia", vcat(pref, [B])))
    end
    return out
end
```
