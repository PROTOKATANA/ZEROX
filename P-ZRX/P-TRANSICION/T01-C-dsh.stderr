Main:
```julia
function main()
    cfg = parsear(ARGS)
    fecha = get(cfg, "fecha", fecha_por_defecto())
    salida = get(cfg, "salida", SALIDA_DEF)
    contrato = get(cfg, "contrato", CONTRATO_DEF)
    idxs, puntos = puntos_negativos()
    ...
    io = open(salida, "w")
    println(io, "# vectores-transicion-negativos-v0 · T01-C · ", fecha, " · sha256 del contrato ", sha256_archivo(contrato))
    n = 0
    malos = 0
    conteo = Dict{String,Int}()
    conteo_fam = Dict{String,Int}()
    for i in idxs
        P = puntos[i]
        for c in casos_negativos(P)
            # verificar oráculo
            resmap = res_por_bloque(c.bloques, P)
            got = resmap[last(c.bloques).id]
            if got != string(c.esperado)
                malos += 1
                println(stderr, "INESPERADO ", c.nombre, " esperado=", c.esperado, " got=", got)
                continue   # no escribir casos no confirmados
            end
            n += 1
            escribir_caso(io, n, c.nombre, i, "-", c.bloques, P)
            conteo[string(c.esperado)] = get(conteo, string(c.esperado), 0) + 1
            conteo_fam[c.familia] = ...
        end
    end
    close(io)
    h = sha256_archivo(salida)
    sha_path = replace(salida, r"\.txt$" => "") * ".sha256"
    write(sha_path, h * "  " * salida * "\n")
    ...
end
```

