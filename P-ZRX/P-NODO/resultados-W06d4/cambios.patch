+        &mut self,
+        slot: u64,
+        salida: [u8; POT_OUTPUT_BYTES],
+        portador: PotCheckpoints,
+    ) -> Result<(), ErrorServicioPot> {
+        if slot == 0 {
+            if salida != self.s1 {
+                return Err(ErrorServicioPot::SalidaPasadaDiscrepante { slot });
+            }
+            return Ok(());
+        }
