+/// V2: un bloque PoST cuyos padres resuelven a dos terminales distintos es inválido (`I-4`).
+#[test]
+fn directed_padres_de_terminales_distintos_es_invalido() {
+    let ta = hash(1);
+    let tb = hash(2);
