+fn comparar_blue_work(a: Option<Rank>, b: Option<Rank>) -> Ordering {
+    match (a, b) {
+        (Some(x), Some(y)) => y.blue_work.cmp(&x.blue_work),
+        (Some(_), None) => Ordering::Less,
+        (None, Some(_)) => Ordering::Greater,
+        (None, None) => Ordering::Equal,
+    }
