+
+    let mezcla = post(99, vec![punta_a, punta_b], 5, 10, 9, 9);
+    let err = cadena.admitir(mezcla).unwrap_err();
+    assert_eq!(err, MotivoBloque::ErrTerminalAmbiguo);
+}
