+        assert_eq!(familia, Familia::Pow);
+        let (cuerpo, sobra) = zx_core::wire::cuerpo_desde_bytes(canonicos).expect("decodifica");
+        assert!(sobra.is_empty(), "no debe sobrar nada");
+        cuerpo
+    }
