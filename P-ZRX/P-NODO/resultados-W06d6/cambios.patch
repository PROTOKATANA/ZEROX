+                ResultadoEnvioTrabajo::Lleno(t)
+            }
+            Err(tokio::sync::mpsc::error::TrySendError::Closed(t)) => {
+                self.bytes_en_cola.fetch_sub(tamano, Ordering::AcqRel);
+                ResultadoEnvioTrabajo::Cerrado(t)
+            }
