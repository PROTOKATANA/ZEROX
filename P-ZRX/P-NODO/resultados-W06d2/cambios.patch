+            return VeredictoFinal::Ignorar;
+        }
+
+        let padre = cabecera.prev_hash;
+        let padre_conocido = self.cadena.es_valido(&padre) || self.cadena.motivo(&padre).is_some();
+        if !padre_conocido {
+            let bloque = BloqueRed::Pow {
+                cabecera,
+                txs,
+                testigos,
+            };
