+            }
+            let evento = self
+                .registro
+                .evento("bloque_red_huerfano")
+                .str("hash", &hash.to_string())
+                .str("padre_ausente", &padre.to_string())
+                .str("familia", "pow")
+                .str("veredicto", "Ignorar");
+            let _ = self.registro.escribir(evento, false);
+            if let (Some(red), Some(peer)) = (self.red.as_ref(), origen) {
