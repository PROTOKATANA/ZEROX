`_mejor!(c::_Cand, v::Int64, v2::Int64, pared, reloj, linea)`:
```julia
function _mejor!(c::_Cand, v::Int64, v2::Int64, pared::Int64, reloj::Int64, linea::Int32)
    if !c.puesto
        c.valor = v; c.valor2 = v2; c.pared = pared; c.reloj = reloj; c.linea = linea; c.puesto = true
        return
    end
    # ¿es más temprano?
    if pared < c.pared || (pared == c.pared && (reloj < c.reloj || (reloj == c.reloj && linea < c.linea)))
        c.valor = v; c.valor2 = v2; c.pared = pared; c.reloj = reloj; c.linea = linea
    end
end
```
