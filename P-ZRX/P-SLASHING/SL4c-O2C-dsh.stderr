Now, `contar_forma_evidencia` in exportar.jl needs to count structure blocks. Let me rewrite it. Current function processes only cbid/orden. I'll extend:

```julia
function contar_forma_evidencia(A::Admision, acc::Dict{String,Int})
    cbid_red = A.pd.P.cbid
    for (id, b) in A.por_id
        motivo = get(A.motivos, id, :OK)
        (motivo == MOTIVO_FORMA_CBID || motivo == MOTIVO_FORMA_ORDEN ||
         motivo == MOTIVO_FORMA_ESTRUCTURA) || continue
        hay_tx = any(tx -> tx.tipo in (Transicion.TxTransferencia, Transicion.TxDeposito,
                                       Transicion.TxRetiro, Transicion.TxLiberacion),
                     b.txs)
        n_cbid = 0; n_orden = 0; n_ig = 0; n_de = 0
        n_ent = 0; n_sal = 0; n_amb = 0; n_tres = 0
        for tx in b.txs
            tx.tipo == Transicion.TxEvidencia || continue
            ev = tx.evidencia
            ev === nothing && continue
            con_ent = !isempty(tx.entradas)
            con_sal = !isempty(tx.salidas)
            con_cbid = ev.id1.cbid != cbid_red || ev.id2.cbid != cbid_red
            con_orden = !(ev.h1.pre_hash < ev.h2.pre_hash)
            con_ent && (n_ent += 1)
            con_sal && (n_sal += 1)
            (con_ent && con_sal) && (n_amb += 1)
            (con_ent && con_cbid && con_orden) && (n_tres += 1)
            con_cbid && (n_cbid += 1)
            if con_orden
                n_orden += 1
                ev.h1.pre_hash == ev.h2.pre_hash ? (n_ig += 1) : (n_de += 1)
            end
        end
        if motivo == MOTIVO_FORMA_ESTRUCTURA
            inc!(acc, "bloque_estructura")
            hay_tx && inc!(acc, "con_tx_estructura")
            d = primer_defecto_forma(A, b)
            d === :entradas ? inc!(acc, "bloque_estructura_entradas") :
                d === :salidas ? inc!(acc, "bloque_estructura_salidas") :
                inc!(acc, "bloque_estructura_ambos")
            n_tres > 0 && inc!(acc, "bloque_estructura_cbid_orden")
            acc["ev_estructura"] = get(acc, "ev_estructura", 0) + max(n_ent + n_sal - n_amb, 1)
        elseif motivo == MOTIVO_FORMA_CBID
            ...existing...
        else
            ...existing...
        end
    end
    return acc
end
```

Hmm, `ev_estructura` count is a bit awkward. Let me simplify and count `ev_estructura` as the number of EvidenceTx with any structure defect (n_ent + n_sal - n_amb). Since `n_ent` counts txs with entradas, `n_sal` counts txs with salidas, `n_amb` counts txs with both; so distinct txs with structure = n_ent + n_sal - n_amb. Good. Use `max(..., 1)`? For a structure-motivated block, there's at least one structure tx, so the value is ≥1. `max(...,1)` handles the (impossible) case. Fine.

