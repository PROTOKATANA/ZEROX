```
function B_par_exacta(f_min, alpha, x; F_max=Inf)
    x <= f_min && return 0.0
    if isinf(F_max)
        alpha <= 2 && error(...)
        # E[f] = (alpha-1)/(alpha-2) fmin
        Ef = (alpha-1)/(alpha-2)*f_min
        xc = min(x, Inf)
        # E[min] = c[(x^{2-a}-fmin^{2-a})/(2-a) + x^{2-a}/(a-1)]
        a = alpha
        c = (a-1)*f_min^(a-1)
        Em = c*((x^(2-a)-f_min^(2-a))/(2-a) + x^(2-a)/(a-1))
        return Em/Ef
    else
        ... existing truncated ...
    end
end
```

