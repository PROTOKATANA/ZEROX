```
function recomendacion_dev(casos)
    filas = Vector{Vector{String}}()
    # caso peor de la pregunta falsable
    αref, Pref, Vref, ehref, fref, qgref = 0.40, 1e-3, 1e5, 1e-3, 1.0, 20.0
    bm = beta_minimo_para_p(αref, F, Pref)
    peor = Dict{String,Any}()
    for caso in casos
        elegido = (existe=false, rho=NaN, Tv=NaN, L=NaN, coste=NaN, Tv_max=NaN)
        for ρ in (0.05,0.1,0.25,0.5,1.0)
            esc = ...
            reg = region_tv(esc, bm.βd; ρ_ret=ρ)
            if reg.existe && (!elegido.existe || reg.Tv_min < elegido.Tv)
                c = coste_disuasion(...)
                elegido = (...)
            end
        end
        push!(filas, [caso.nombre, ...])
        ...
    end
    # robusta = max over casos of Tv (only if all exist)
    ...
end
```

Hmm, the ρ grid for choosing smallest Tv should include small ρ. ρ=0.05? The escenarios grid has {0.10,0.25,0.50,1.00}. Let me keep those. For the robust T_v, I want the max over cases of the minimal Tv among ρ. But since ρ=0.1 gives the largest Tv_max and moderate Tv_min, it's likely the robust choice. Let me just compute for each ρ the max over cases of Tv_min (if exists for all cases), then pick the ρ with the smallest max Tv_min. That gives the robust (ρ, T_v) pair covering all cases.

Let me implement:
```
function recomendacion_dev(casos)
    filas = ...
    # Pregunta falsable en su punto más duro: α=0.40, P*=1e-3, V=1e5, f=1, qg=20, eh=1e-3
    αref=0.40; Pref=1e-3; Vref=1e5; ehref=1e-3
    bm = beta_minimo_para_p(αref, p("F_slots"), Pref)
    for ρ in (0.10,0.25,0.50,1.00)
        maxTv = 0.0; todos = true; detalle = String[]
        for caso in casos
            esc = escenario_de(caso, Vref, 1.0, 20.0, 0.0, ehref, p("f_honesto"), :P1, Pref)
            reg = region_tv(esc, bm.βd; ρ_ret=ρ)
            if reg.existe
                maxTv = max(maxTv, reg.Tv_min)
                push!(detalle, caso.nombre*"="*fmt(reg.Tv_min;d=4))
            else
                todos = false
                push!(detalle, caso.nombre*"=NO")
            end
        end
        push!(filas, [fmt(ρ), bool(todos), fmt(maxTv), join(detalle,";"), "robusta...";])
    end
    # central only
    ...
end
