```
function masa_prob(dist::Pareto, x; F_max = Inf)
    x <= dist.f_min && return 0.0
    b = 2 - dist.alpha
    if isinf(F_max)
        dist.alpha <= 2 && throw(...)
        return 1 - (dist.f_min / x)^(dist.alpha - 2)
    else
        x = min(x, F_max)
        return (x^b - dist.f_min^b) / (F_max^b - dist.f_min^b)
    end
end
```
