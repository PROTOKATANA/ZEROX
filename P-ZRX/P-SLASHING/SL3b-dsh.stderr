Let me write:

```julia
"Conjunto de evidencias aplicadas en la historia seleccionada de `A` (id, índiceTx)."
function evidencias_aplicadas(A::Admision)
    _, orden, desc = aplicar_historia(A)
    descartadas = Set{Tuple{Int,Int}}((idb, itx) for (idb, itx, _) in desc)
    ops = Set{Tuple{Int,Int}}()
    for bid in orden
        b = A.por_id[bid]
        for (i, tx) in enumerate(b.txs)
            tx.tipo == Transicion.TxEvidencia || continue
            (bid, i) in descartadas || push!(ops, (bid, i))
        end
    end
    return ops
end

"""
Evidencias **aplicadas en algún estado y luego deshechas por una reorganización**:
se reprocesa la historia en orden de `id` sobre una `Admision` nueva y, tras cada
bloque que cambia la punta seleccionada, se cuentan las evidencias que estaban
aplicadas en la historia anterior y ya no lo están (EV-27/EV-28). Devuelve el
conjunto de pares `(idBloque, índiceTx)`.
"""
function evidencias_deshechas_por_reorg(A::Admision)
    A2 = Admision(A.pd, A.pow_bloques, A._id_T)
    bloques = sort(collect(values(A.por_id)); by = b -> b.id)
    prev_tip = A._id_T
    prev_ev = Set{Tuple{Int,Int}}()
    deshechas = Set{Tuple{Int,Int}}()
    for b in bloques
        b.id in A2.procesados && continue
        procesar_uno!(A2, b)
        tips = tips_validas(A2)
        isempty(tips) && continue
        tip = mejor_punta(A2, tips)
        ev = evidencias_aplicadas(A2)
        if tip != prev_tip
            for x in setdiff(prev_ev, ev)
                push!(deshechas, x)
            end
        end
        prev_tip = tip
        prev_ev = ev
    end
    return deshechas
end
```

Wait: there's an issue. If a block contains no evidence, `evidencias_aplicadas` recomputes; that's expensive. We can early-return if the case has no evidence at all:
```julia
    any(b -> any(tx -> tx.tipo == Transicion.TxEvidencia, b.txs), values(A.por_id)) || return Set{Tuple{Int,Int}}()
```
That makes `cobertura_run` cheap (evp=false → no evidence). Good.

Also, `A.procesados` is a Set of ids? Yes used as `b.id in A2.procesados`. Good.

Now `contar_evidencia` in exportar.jl. Let me rewrite it:

```julia
"""
Clasifica las `EvidenceTx` de `A` por su resultado en la historia seleccionada.

Definiciones de los contadores (se escriben en `cobertura-v0.5.txt`):
 * `construida`  — EvidenceTx presente en un bloque de la historia de aplicación
                   seleccionada (cualquier rama).
 * `aplicada`    — se aplica sin descarte al aplicarse su bloque.
 * `sin_saldo`   — aplicada con `V = 0` en la clave (EV-22): pérdida 0, incidente
                   registrado; se mide contra `past(bloque)`.
 * `duplicada` / `tardia` / `cbid_ajeno` / `con_entradas` / `orden_canonico` /
   `sin_evidencia` / `otro` — descartes por el error indicado.
 * `deshecha`    — aplicada en la historia seleccionada en algún momento y luego
                   retirada por una reorganización (EV-27/EV-28). No cuenta el
                   undo exacto de un bloque que sigue seleccionado.
"""
function contar_evidencia(A::Admision, acc::Dict{String,Int})
    _, orden, desc = aplicar_historia(A)
    dm = Dict{Tuple{Int,Int},Transicion.Err}()
    for (idb, itx, e) in desc
        dm[(idb, itx)] = e
    end
    for bid in orden
        b = A.por_id[bid]
        for (i, tx) in enumerate(b.txs)
            tx.tipo == Transicion.TxEvidencia || continue
            inc!(acc, "construida")
            e = get(dm, (bid, i), nothing)
            if e === nothing
                ev = tx.evidencia
                k = ev === nothing ? 0 : ev.id1.clave
                g = get(A.past[bid].garantias, k, nothing)
                V = g === nothing ? Int128(0) : Transicion.total_garantia(g)
                inc!(acc, V == 0 ? "sin_saldo" : "aplicada")
            else
                k = ... error mapping
                inc!(acc, k)
            end
        end
    end
    inc!(acc, "deshecha", length(EstadoDAG.evidencias_deshechas_por_reorg(A)))
    return acc
end
```

