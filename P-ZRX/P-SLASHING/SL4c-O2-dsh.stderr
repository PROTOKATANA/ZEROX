Now add the forma directed generator. Let me write it after `caso_evidencia_descartes`:

```julia
"""
D-19…D-23 · Forma v4 de la `EvidenceTx` (SL-4c-O). Un bloque `X` lleva coinbase,
`con_tx` una transferencia válida y una `EvidenceTx` con `cbid` ajeno (`:cbid`),
orden no canónico (`:orden`) o ambos (`:ambos`). `X` es **inválido en la
admisión** (no un descarte) y su hijo `Y` cae por `ErrSinPadre`. Un gemelo válido
`Xv` (mismas txs pero evidencia canónica de la red local) demuestra que solo el
defecto invalida.
"""
function caso_forma_evidencia(pd::ParamsDAG; modo::Symbol = :cbid, con_tx::Bool = true,
                              seed::Int = 40, iter::Int = 0,
                              slot::Int = 2, id_base::Int = -1)
    A, pow = base_dirigida(pd; seed = seed + iter)
    P = pd.P
    id1 = id_base > 0 ? id_base : pow[3] + 6000 * iter
    Tb = BloquePost(id = id1, padres = [A._id_T], slot = 1, productor = 1, peso = 1,
                    txs = Transicion.Tx[Transicion.tx_coinbase_post(3)])
    procesar_uno!(A, Tb)
    txs = Transicion.Tx[Transicion.tx_coinbase_post(3)]
    out_id = 0
    if con_tx
        o = utxo_gastable(A.post[Tb.id], P, slot, 2)
        o === nothing && error("caso_forma_evidencia: sin UTXO gastable")
        out_id = 800000 + 100 * iter
        push!(txs, Transicion.tx_transferencia([o.id],
            [Transicion.Salida(out_id, o.valor - UInt64(1), o.dueño,
                               Transicion.OrigenTx, -1, -1)], o.dueño))
    end
    ev_bad = _evidencia_forma(P, modo, slot, iter)
    X = BloquePost(id = id1 + 1, padres = [Tb.id], slot = slot, sd = 0,
                   productor = 1, peso = 1,
                   txs = vcat(txs, Transicion.Tx[Transicion.tx_evidencia(ev_bad)]))
    procesar_uno!(A, X)
    # Gemelo válido: misma forma, evidencia canónica de la red local.
    ev_ok = Transicion.evidencia(P.cbid, 1, 0, 0, 0, slot,
                                 UInt64(900001 + iter), UInt64(900002 + iter))
    Xv = BloquePost(id = id1 + 2, padres = [Tb.id], slot = slot, sd = 1,
                    productor = 1, peso = 1,
                    txs = vcat(txs, Transicion.Tx[Transicion.tx_evidencia(ev_ok)]))
    procesar_uno!(A, Xv)
    Y = BloquePost(id = id1 + 3, padres = [X.id], slot = slot + 1, sd = 0,
                   productor = 1, peso = 1,
                   txs = Transicion.Tx[Transicion.tx_coinbase_post(3)])
    procesar_uno!(A, Y)
    motivo = get(A.motivos, X.id, :?)
    tx_aplicada = con_tx && out_id != 0 && haskey(A.post[Xv.id].utxo, out_id)
    return "D-19", A, (modo = modo, con_tx = con_tx, X = X.id, Xv = Xv.id, Y = Y.id,
                       out_id = out_id, invalido = !A.validos[X.id],
                       motivo = motivo, hijo_invalido = !A.validos[Y.id],
                       gemelo_valido = A.validos[Xv.id], tx_aplicada = tx_aplicada,
                       I1 = invariante_I1(A.post[Xv.id]))
end
```

