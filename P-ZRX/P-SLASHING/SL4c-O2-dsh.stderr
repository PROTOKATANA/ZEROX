function evidencia_aleatoria(rng, S, P, slot; modo=:valida)
    c = P.cbid
    k = 1
    s = slot
    if modo == :cbid
        c = P.cbid + 1
    elseif modo == :tardia
        s = slot - P.Plazo_slots
    elseif modo == :sin_saldo
        k = 99
    elseif modo == :clave
        ks = sort(collect(keys(S.garantias)))
        isempty(ks) || (k = ks[rand(rng, 1:length(ks))])
    end
    r1 = rand(rng, UInt64)
    r2 = rand(rng, UInt64)
    if modo == :orden
        # orden no canónico: H1.pre_hash >= H2.pre_hash
        r2 = r1
    elseif modo == :ambos
        c = P.cbid + 1
        r2 = r1
    end
    r1 == r2 && (r2 = r1 + UInt64(1))
    lo, hi = min(r1, r2), max(r1, r2)
    ev = Transicion.evidencia(c, k, 0, 0, 0, s, lo, hi)
    return Transicion.tx_evidencia(ev)
end
```
