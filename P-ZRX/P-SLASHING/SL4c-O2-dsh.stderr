```julia
function main()
    ruta = isempty(ARGS) ? "resultados/vectores-estado-dag-v0.5.txt" : ARGS[1]
    salida = length(ARGS) >= 2 ? ARGS[2] : "resultados/DIFERENCIAS-v0.5-v0.6.md"
    casos = parsear_fichero(ruta)
    lineas = String[]
    n_cambiados = 0
    fallos = String[]
    for caso in casos
        pd = parsear_params(caso.param)
        A, _ = reconstruir(caso)
        def = defectos_del_caso(caso, pd)
        # new results
        res_new = Dict{Int,String}()
        for b in caso.post_bloques
            res_new[b.id] = get(A.validos, b.id, false) ? "OK" : string(get(A.motivos, b.id, :ErrSinPadre))
        end
        S, _, desc = aplicar_historia(A)
        desc_new = String[string("DESC bloque=", idb, " tx=", itx, " motivo=", err) for (idb,itx,err) in desc]
        tips = tips_validas(A)
        sp = isempty(tips) ? -1 : mejor_punta(A, tips)
        utxo_new = r_utxo(S); gar_new = r_gar(S); est_new = r_est(S)
        # compare
        cambios = String[]
        for b in caso.post_bloques
            nuevo = res_new[b.id]
            viejo = get(caso.res, b.id, "<falta>")
            viejo == nuevo || push!(cambios, "  - bloque $(b.id): `$viejo` → `$nuevo`")
        end
        caso.desc == desc_new || push!(cambios, "  - DESC: $(length(caso.desc)) → $(length(desc_new)) líneas")
        caso.sel == sp || push!(cambios, "  - SEL: $(caso.sel) → $sp")
        caso.utxo == utxo_new || push!(cambios, "  - UTXO distinto")
        caso.gar == gar_new || push!(cambios, "  - GAR distinto")
        caso.est == est_new || push!(cambios, "  - EST: `$(caso.est)` → `$est_new`")
        if !isempty(cambios)
            n_cambiados += 1
            bloques_def = sort(collect(keys(def)))
            if isempty(bloques_def)
                push!(fallos, "caso $(caso.n) ($(caso.nombre)) cambió sin defecto de forma")
            end
            push!(lineas, "### Caso $(caso.n) · $(caso.nombre) · punto=$(caso.punto) k=$(caso.k) · semilla=$(caso.semilla)")
            push!(lineas, "")
            if isempty(bloques_def)
                push!(lineas, "- **Sin defecto de forma detectado: FALLO de SL-4c-O.**")
            else
                for idb in bloques_def
                    push!(lineas, "- Bloque $(idb) con defecto(s) de forma: $(join(string.(def[idb]), ", ")).")
                end
            end
            append!(lineas, cambios)
            push!(lineas, "")
        end
    end
    ...
end
```

