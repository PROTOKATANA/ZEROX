```julia
function reconstruir(caso::CasoLeido)
    pd = parsear_params(caso.param)
    isempty(caso.pow_bloques) && return (nothing, pd)
    idT = caso.pow_bloques[end].id
    A = Admision(pd, caso.pow_bloques, idT)
    resolver!(A, caso.post_bloques)
    return (A, pd)
end
```

Then compare:
```julia
function defectos_del_caso(caso::CasoLeido, pd::ParamsDAG)
    # returns (blocks with cbid defect, blocks with order defect)
    cbid_red = pd.P.cbid
    def = Dict{Int,Vector{Symbol}}()   # block id -> defectos
    for b in caso.post_bloques
        ds = Symbol[]
        for tx in b.txs
            tx.tipo == Transicion.TxEvidencia || continue
            ev = tx.evidencia
            ev === nothing && continue
            if ev.id1.cbid != cbid_red || ev.id2.cbid != cbid_red
                push!(ds, :cbid)
            end
            if !(ev.h1.pre_hash < ev.h2.pre_hash)
                push!(ds, :orden)
            end
        end
        isempty(ds) || (def[b.id] = ds)
    end
    return def
end
```

Hmm, `parsear_tx` reconstructs `Transicion.TxEvidencia` with `tx_evidencia(ev)`. For a malformed evidence (no `ev`), `tx_evidencia(clave)` with `evidencia === nothing`. Skip those.

