+/// Pares `(bloque, índice)` de evidencia aplicada en la historia seleccionada (ED-*).
+fn evidencias_aplicadas(cadena: &Cadena) -> BTreeSet<(BlockHash, usize)> {
+    let Ok((_estado, orden, desc)) = cadena.aplicar_historia() else {
+        return BTreeSet::new();
