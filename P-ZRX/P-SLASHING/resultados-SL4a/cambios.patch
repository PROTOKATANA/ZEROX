+    let mut w = PreimageWriter::con_capacidad(4 + 32 + 2 + 8 + 32 + 8);
+    w.u32(cbid)
+        .h32(public_key)
+        .u16(sector_index)
+        .u64(history_size)
+        .h32(chunk)
+        .u64(slot);
+    w.finish(TAG_EVP_INCIDENTE)
