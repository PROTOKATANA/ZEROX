```
function caso_dos_evidencias(P::Params, primer::Symbol)
    # primer ∈ (:orden, :cbid): defect of the first evidence in the block.
    rng = StableRNG(0x...) 
    bloques, estados = _prefijo_ev(rng, P; n_post = 1)
    E = estados[end]
    parent = bloques[end].id
    s = E.slot + 1
    # ev1 with the given defect; ev2 with the other.
    if primer == :orden
        ev1 = evidencia(P.cbid, 1, 0, 0, 0, s, ph_desc_1, ph_desc_2)  # descending
        ev2 = evidencia(P.cbid + 1, 1, 0, 0, 0, s, ph_ok_1, ph_ok_2)  # cbid ajeno
    else
        ev1 = evidencia(P.cbid + 1, 1, 0, 0, 0, s, ph_ok_1, ph_ok_2)
        ev2 = evidencia(P.cbid, 1, 0, 0, 0, s, ph_desc_1, ph_desc_2)
    end
    txs = [tx_coinbase_post(3), tx_evidencia(ev1), tx_evidencia(ev2)]
    B = gen_post(...)
    return (bloques_with_B, expected)
end
```

