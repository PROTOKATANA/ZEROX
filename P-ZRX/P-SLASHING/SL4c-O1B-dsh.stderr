4. Directed cases function:
```
"""
Dos evidencias en un bloque (modo estricto T01): la primera que falla manda.
`primer` ∈ (:orden, :cbid) fija el defecto de la primera evidencia.
Cadena de bloques con el bloque final; devuelve `(bloques, esperado)` o `nothing`.
"""
function caso_dos_evidencias(P::Params, primer::Symbol)
    rng = StableRNG(0x5b00 + UInt64(primer == :orden ? 1 : 2))
    bloques, estados = _prefijo_ev(rng, P; n_post = 1)
    E = estados[end]
    E.terminal == -1 && return nothing
    parent = bloques[end].id
    s = E.slot + 1
    # evidencia válida (canónica, cbid local): ph1 < ph2
    ok1 = UInt64(6001)
    ok2 = UInt64(6002)
    # evidencia con orden descendente: ph1 > ph2
    mal_orden = (UInt64(7002), UInt64(7001))
    if primer == :orden
        e1 = evidencia(P.cbid, 1, 0, 0, 0, s, mal_orden[1], mal_orden[2])
        e2 = evidencia(P.cbid + 1, 1, 0, 0, 0, s, ok1, ok2)
        esperado = ErrForma(OrdenCanonicoInvalido)
    else
        e1 = evidencia(P.cbid + 1, 1, 0, 0, 0, s, ok1, ok2)
        e2 = evidencia(P.cbid, 1, 0, 0, 0, s, mal_orden[1], mal_orden[2])
        esperado = ErrForma(EvidenciaCbidAjeno)
    end
    txs = Tx[tx_coinbase_post(3), tx_evidencia(e1), tx_evidencia(e2)]
    B = gen_post(id = parent + 1, padre = parent, slot = s, productor = 1,
                 peso = 1, txs = txs)
    return (vcat(bloques, [B]), esperado)
end
```
