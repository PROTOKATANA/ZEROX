Update `_evidencia_forma`:
```julia
"Evidencia con el defecto de forma pedido (SL-4c-O/SL-4c-O-B)."
function _evidencia_forma(P::Transicion.Params, modo::Symbol, slot::Int, i::Int)
    a = UInt64(700001 + 2 * i)
    b = UInt64(700002 + 2 * i)
    if modo == :cbid
        return Transicion.evidencia(P.cbid + 1, 1, 0, 0, 0, slot, a, b)
    elseif modo == :orden_desc || modo == :orden
        return Transicion.evidencia(P.cbid, 1, 0, 0, 0, slot, b, a)   # H1 > H2
    elseif modo == :orden_igual
        return Transicion.evidencia(P.cbid, 1, 0, 0, 0, slot, a, a)   # H1 = H2
    elseif modo == :ambos
        return Transicion.evidencia(P.cbid + 1, 1, 0, 0, 0, slot, b, a)
    elseif modo == :ambos_igual
        return Transicion.evidencia(P.cbid + 1, 1, 0, 0, 0, slot, a, a)
    end
    error("modo de forma desconocido: $modo")
end
```

