New:
```julia
function contar_forma_evidencia(A::Admision, acc::Dict{String,Int})
    cbid_red = A.pd.P.cbid
    for (id, b) in A.por_id
        motivo = get(A.motivos, id, :OK)
        (motivo == MOTIVO_FORMA_CBID || motivo == MOTIVO_FORMA_ORDEN) || continue
        hay_tx = any(tx -> tx.tipo in (Transicion.TxTransferencia, Transicion.TxDeposito,
                                       Transicion.TxRetiro, Transicion.TxLiberacion),
                     b.txs)
        n_cbid = 0
        n_orden = 0
        for tx in b.txs
            tx.tipo == Transicion.TxEvidencia || continue
            ev = tx.evidencia
            ev === nothing && continue
            (ev.id1.cbid != cbid_red || ev.id2.cbid != cbid_red) && (n_cbid += 1)
            ev.h1.pre_hash < ev.h2.pre_hash || (n_orden += 1)
        end
        if motivo == MOTIVO_FORMA_CBID
            inc!(acc, "bloque_cbid")
            acc["ev_cbid"] = get(acc, "ev_cbid", 0) + max(n_cbid, 1)
            hay_tx && inc!(acc, "con_tx_cbid")
            n_orden > 0 && inc!(acc, "ambos_cbid")
        else
            inc!(acc, "bloque_orden")
            hay_tx && inc!(acc, "con_tx_orden")
            d = primer_defecto_forma(A, b)
            d === :orden_igual ? inc!(acc, "bloque_orden_igual") :
                                 inc!(acc, "bloque_orden_desc")
            # nº de evidencias con cada tipo de orden no canónico
            n_ig = count(tx -> tx.tipo == Transicion.TxEvidencia && tx.evidencia !== nothing &&
                                tx.evidencia.h1.pre_hash == tx.evidencia.h2.pre_hash, b.txs)
            n_de = count(tx -> tx.tipo == Transicion.TxEvidencia && tx.evidencia !== nothing &&
                                tx.evidencia.h1.pre_hash > tx.evidencia.h2.pre_hash, b.txs)
            acc["ev_orden_igual"] = get(acc, "ev_orden_igual", 0) + max(n_ig, 1)
            acc["ev_orden_desc"] = get(acc, "ev_orden_desc", 0) + max(n_de, 1)
        end
    end
    return acc
end
```

