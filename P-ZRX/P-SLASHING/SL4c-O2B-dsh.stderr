```julia
function contar_forma_evidencia(A, acc)
    for (id, b) in A.por_id
        d = primer_defecto_forma(A, b)
        d === nothing && continue
        hay_tx = any(...)
        if d === :cbid
            inc!(acc, "bloque_cbid")
            hay_tx && inc!(acc, "con_tx_cbid")
            # count if block also has an order defect somewhere
            any order defect && inc!(acc, "ambos_cbid")
            # ev_cbid etc.
        else
            inc!(acc, "bloque_orden")
            d === :orden_desc ? inc!(acc, "bloque_orden_desc") : inc!(acc, "bloque_orden_igual")
            hay_tx && inc!(acc, "con_tx_orden")
        end
    end
end
```
