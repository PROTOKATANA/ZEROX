+        // inválida. Truncarla olvidaría una firma previa si hubo corrupción; falla cerrado.
+        let mut f = std::fs::OpenOptions::new().write(true).open(&ruta).unwrap();
+        use std::io::{Seek, SeekFrom, Write};
