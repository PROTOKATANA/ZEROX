+    fn id(chunk: u8, slot: u64) -> IdentidadTicket {
+        IdentidadTicket::rat1(
+            7,
+            ClavePublica::desde_bytes([1u8; 32]),
+            0,
+            1 << 20,
+            [chunk; 32],
+            slot,
+        )
+    }
+
+    fn ph(n: u8) -> PreHash {
