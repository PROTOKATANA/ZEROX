+    fn ventana_cerrada_no_se_incluye_y_sale_de_la_lista() {
+        let (mut d, _id, _clave, _slot) = detector_con_incidente();
+        // `slot_falta = 100`, plazo 300 ⇒ la ventana cierra en 400.
+        assert_eq!(
