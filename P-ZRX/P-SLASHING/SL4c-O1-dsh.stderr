```julia
function ultimo_error(bloques::Vector{Bloque}, P::Params)
    memo, _ = construir_validos(bloques, P)
    B = last(bloques)
    Ep = get(memo, B.padre, nothing)
    Ep === nothing && return nothing
    r = aplicar(Ep, B, P)
    return r isa Err ? r : nothing
end
```

