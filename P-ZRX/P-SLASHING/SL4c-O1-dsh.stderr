Let me write the comparator script `comparar_vectores.jl`. It should produce `DIFERENCIAS-v0.4-v0.5.md` directly. Let me write it carefully.

```julia
# comparar_vectores.jl — diferencia T01 v0.4 vs v0.5 caso por caso (SL-4c-O).
#
#     julia comparar_vectores.jl A.txt B.txt SALIDA.md
#
# No usa el módulo Transicion: es una comparación de texto. Empareja los CASO
# por (nombre, punto, semilla, índice de repetición) — el `n=` secuencial cambia
# al insertar casos nuevos y no se usa —, exige que el cuerpo (todo salvo las
# líneas `RES`) sea idéntico en cada par y lista los cambios de `RES` y los
# casos nuevos. Sale con código ≠ 0 si un par emparejado difiere en algo que no
# sea `RES`, o si falta en B un caso de A.

const RE_CASO = r"^CASO n=\d+ nombre=(\S+) punto=(\S+) semilla=(\S+)"
const RE_RES = r"^RES bloque=(\d+) res=(\S+)"

function leer(ruta)
    casos = Dict{Tuple{Tuple{String,String,String},Int},Vector{Vector{String}}}()
    idx = Dict{Tuple{String,String,String},Int}()
    actual = String[]
    clave = nothing
    for linea in eachline(ruta)
        if startswith(linea, "CASO ")
            actual = String[linea]
            m = match(RE_CASO, linea)
            base = (String(m[1]), String(m[2]), String(m[3]))
            k = get(idx, base, 0) + 1
            idx[base] = k
            clave = (base, k)
        elseif startswith(linea, "FIN")
            push!(actual, linea)
            push!(get!(casos, clave, Vector{Vector{String}}()), actual)
            actual = String[]
            clave = nothing
        elseif !isempty(actual)
            push!(actual, linea)
        end
    end
    return casos
end

function cuerpo_res(bl)
    cuerpo = String[]
    res = Dict{Int,String}()
    for l in bl
        (startswith(l, "CASO ") || startswith(l, "FIN")) && continue
        m = match(RE_RES, l)
        if m !== nothing
            res[parse(Int, m[1])] = String(m[2])
        else
            push!(cuerpo, l)
        end
    end
    return join(cuerpo, "\n"), res
end
```

Wait, the RES line format is `RES bloque=1 res=OK`. Good.

Then:
```julia
function main()
    (length(ARGS) == 3) || error("uso: comparar_vectores.jl A.txt B.txt SALIDA.md")
    A, B, salida = ARGS
    ca = leer(A); cb = leer(B)
    cambios = Tuple{String,String,String,String}[]
    fallos = String[]
    nuevos = String[]
    for (k, bls) in sort(collect(ca); by = x -> string(x[1]))
        if !haskey(cb, k)
            push!(fallos, "falta en B: $(k)")
            continue
        end
        blsa = bls[1]; blsb = cb[k][1]
        ca_cur, ra = cuerpo_res(blsa)
        cb_cur, rb = cuerpo_res(blsb)
        if ca_cur != cb_cur
            push!(fallos, "cuerpo distinto: $(k)")
        end
        for bid in sort(collect(union(keys(ra), keys(rb))))
            va = get(ra, bid, "<falta>"); vb = get(rb, bid, "<falta>")
            va == vb || push!(cambios, (string(k[1]), string(bid), va, vb))
        end
    end
    for (k, _) in sort(collect(cb); by = x -> string(x[1]))
        haskey(ca, k) || push!(nuevos, string(k))
    end
    ...
end
```

