### aplicar_evidencia! changes

```julia
function aplicar_evidencia!(E::Estado, B::Bloque, P::Params, punto::Int, tx::Tx)
    tx.evidencia === nothing && return ErrSinEvidencia      # EV-01
    (isempty(tx.entradas) && isempty(tx.salidas)) || return ErrEvidenciaConEntradas  # EV-04
    ev = tx.evidencia
    # SL-4c-O · precedencia de forma: estructura → cbid → orden canónico.
    (ev.id1.cbid == P.cbid && ev.id2.cbid == P.cbid) ||
        return ErrForma(EvidenciaCbidAjeno)                 # RAT-1
    ev.h1.pre_hash < ev.h2.pre_hash ||
        return ErrForma(OrdenCanonicoInvalido)              # EV-01/EV-04
    # --- verificación semántica (orden y resultado sin cambios) ---
    ev.id1 == ev.id2 || return ErrSinEvidencia              # EV-06
    (ev.h1.sello_ok && ev.h2.sello_ok) || return ErrSinEvidencia  # EV-07
    P.R_slots > P.Plazo_slots + P.M_margen_slots || return ErrPuertaRAT3  # RAT-3
    sf = ev.id1.slot
    (sf <= punto < sf + P.Plazo_slots) || return ErrEvidenciaTardia  # EV-13/EV-14
    ...
end
```

