```julia
# comparar_vectores.jl — compara dos exportaciones de vectores T01 caso por caso.
#
#     julia compare... no, plain julia (sin project) comparar_vectores.jl A.txt B.txt
#
# Empareja cada CASO por (nombre, punto, semilla, índice de repetición), compara
# todas las líneas salvo `RES` y lista los cambios de `RES` (viejo → nuevo) y
# los casos nuevos. Sale con código ≠ 0 si un par emparejado difiere en algo que
# no sea una línea `RES`.

function leer_casos(ruta)
    casos = Dict{Any,Vector{Vector{String}}}()   # clave => lista de bloques
    actual = String[]
    clave = nothing
    idx = Dict{Any,Int}()
    for linea in eachline(ruta)
        startswith(linea, "#") && continue
        isempty(strip(linea)) && continue
        if startswith(linea, "CASO ")
            actual = String[linea]
        elseif startswith(linea, "FIN")
            push!(actual, linea)
            # clave sin `n=`
            m = match(r"CASO n=\d+ nombre=(\S+) punto=(\S+) semilla=(\S+)", actual[1])
            base = (m[1], m[2], m[3])
            k = get(idx, base, 0) + 1
            idx[base] = k
            key = (base, k)
            push!(get!(casos, key, Vector{Vector{String}}()), actual)
            actual = String[]
        else
            push!(actual, linea)
        end
    end
    return casos
end
```

