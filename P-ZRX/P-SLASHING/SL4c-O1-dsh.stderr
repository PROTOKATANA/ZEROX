    @test aplicar(Eb, mk(evidencia(P.cbid, 1, 0, 0, 0, s, 100, 50;
                                   id2 = IdentidadEvidencia(P.cbid, 1, 0, 0, 0, s + 1))), P) ==
          ErrForma(OrdenCanonicoInvalido)
    # la forma precede a sellos inválidos
