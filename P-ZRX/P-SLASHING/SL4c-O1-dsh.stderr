          ErrForma(OrdenCanonicoInvalido)
    # cbid ajeno + identidad distinta: gana cbid
    @test aplicar(Eb, mk(evidencia(P.cbid + 1, 1, 0, 0, 0, s, 50, 60;
                                   id2 = IdentidadEvidencia(P.cbid, 1, 0, 0, 0, s + 1))), P) ==
          ErrForma(EvidenciaCbidAjeno)
    # la estructura precede a la forma: con salidas ⇒ ErrEvidenciaConEntradas aunque cbid sea ajeno
    Bev = Tx(TxEvidencia, [Salida(900002, UInt64(1), 1, OrigenTx, -1, -1)],
             Int[], 0, 1, UInt64(0), 0, UInt64(0),
             evidencia(P.cbid + 1, 1, 0, 0, 0, s, 100, 50))
    Bmal = gen_post(id = blb[end].id + 1, padre = blb[end].id, slot = s,
                    productor = 1, peso = 1, txs = [tx_coinbase_post(3), Bev])
    @test aplicar(Eb, Bmal, P) == ErrEvidenciaConEntradas

    # cobertura ≥ 30 por tipo y ≥ 5 con ambos defectos
