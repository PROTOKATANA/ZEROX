function meta(bloque)
    l = first(split(bloque, "\n"))
    m = match(r"^CASO n=(\d+) nombre=(\S+) punto=(\S+) semilla=(\S+)", l)
    return (parse(Int,m[1]), String(m[2]), String(m[3]), String(m[4]))
end
```
