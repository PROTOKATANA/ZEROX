```julia
function aplicar_evidencia!(E, B, P, punto, tx)
    tx.evidencia === nothing && return ErrSinEvidencia
    (isempty(tx.entradas) && isempty(tx.salidas)) || return ErrEvidenciaConEntradas
    ev = tx.evidencia
    # SL-4c-O: precedencia de forma = estructura → cbid → orden canónico.
    (ev.id1.cbid == P.cbid && ev.id2.cbid == P.cbid) ||
        return ErrForma(EvidenciaCbidAjeno)          # RAT-1
    ev.h1.pre_hash < ev.h2.pre_hash ||
        return ErrForma(OrdenCanonicoInvalido)       # EV-01/EV-04
    # --- semántica (sin cambios) ---
    ev.id1 == ev.id2 || return ErrSinEvidencia       # EV-06
    (ev.h1.sello_ok && ev.h2.sello_ok) || return ErrSinEvidencia  # EV-07
    P.R_slots > P.Plazo_slots + P.M_margen_slots || return ErrPuertaRAT3
    ...
end
```
