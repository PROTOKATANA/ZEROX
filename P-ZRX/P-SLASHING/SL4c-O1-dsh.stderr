        if got == ErrForma(OrdenCanonicoInvalido); n_orden += 1; end
        if nombre == "ev-ambos"; n_ambos += 1; end
    end
    @test n_cbid >= 30
    @test n_orden >= 30
    @test n_ambos >= 5
end
