```julia
function perdida_castigo(esc::Escenario; ρ_ret, Tv)
    Tveff = Tv + esc.R_slots
    retenido = esc.via_perdida === :P2 ?
        ρ_ret * esc.I * esc.λ * f_media_de(esc.dist) * Tveff / 2 :
        ρ_ret * esc.I * Tveff
    return esc.f_conf * (retenido + esc.q_g) + esc.c_r
end
```
