```julia
# =============================================================================
# 9 · SL-2b · recompensa al incluidor (s) y censura
# =============================================================================

const CASOS_S2B = ...  # not needed

"Etiqueta de atacante."
atacante(conf::Bool) = conf ? "confabulado" : "no_confabulado"

"""
    barrido_region_s2(casos) -> Vector{Vector{String}}

Repite el barrido `region.csv` para los dos atacantes con `s = s_incluidor` (2/8): región de la
rejilla principal en `region-s2.csv`. Cuenta las celdas que se pierden (existían para el no
confabulado y no para el confabulado) y las escribe en `resumen-s2b.csv`.
"""
function barrido_region_s2(casos)
    s2 = p("s_incluidor")
    filas = Vector{Vector{String}}()
    resumen = Vector{Vector{String}}()
    for caso in casos
        perdidas = 0; total_no = 0; total_si = 0; n_celdas = 0
        for α in grid("alpha_atacante", [0.20,0.25,0.33,0.40]), P in grid("P_objetivo", [1e-6,1e-3,0.5])
            bm = beta_cache(α, P)
            βd = bm.βd
            for V in grid("V",[1e4]), f in grid("f_conf",[1.0]), qg in grid("q_g",[20.0]),
                eh in grid("eps_honesto",[1e-3]), ρ in grid("rho_ret",[0.5])
                for conf in (false, true)
                    esc = escenario_de(caso, V, f, qg, 0.0, eh, p("f_honesto"), :P1, P; s = s2)
                    reg = isnan(βd) ? (existe=false, Tv_min=Inf, Tv_max=0.0, borde_inf="—",
                                       borde_sup="—", B_min=NaN, N_paid_min=NaN, L_min=NaN,
                                       motivo="P* inalcanzable") :
                          region_tv(esc, βd; ρ_ret = ρ, confabulado = conf)
                    push!(filas, [caso.nombre, fmt(α;d=3), fmt(P;d=3), fmt(βd;d=6), fmt(V;d=6),
                                  fmt(f;d=3), fmt(qg;d=6), fmt(eh;d=4), fmt(s2;d=4), atacante(conf),
                                  fmt(ρ;d=3), bool(reg.existe), fmt(reg.Tv_min;d=6), fmt(reg.Tv_max;d=6),
                                  reg.borde_inf, reg.borde_sup, fmt(reg.B_min;d=6),
                                  fmt(reg.N_paid_min;d=6), fmt(reg.L_min;d=6), reg.motivo])
                    if conf
                        total_si += reg.existe
                    else
                        total_no += reg.existe
                    end
                end
                n_celdas += 1
            end
        end
        ...
    end
end
```

