```julia
function comprobaciones_s2b(casos)
    filas = Vector{Vector{String}}()
    s2 = p("s_incluidor")
    central = casos[1]
    # (i) s=0 reproduce SL-2: confabulado no cambia la pérdida
    e0 = escenario_de(central, 1e5, 1.0, 20.0, 0.0, 1e-3, 1e-3, :P1, 1e-3; s=0.0)
    L0n = perdida_castigo(e0; ρ_ret=0.5, Tv=3600.0, confabulado=false)
    L0c = perdida_castigo(e0; ρ_ret=0.5, Tv=3600.0, confabulado=true)
    push!(filas, ["s=0 · L_conf == L_no", fmt(L0c;d=12), fmt(L0n;d=12), "control reproduce SL-2",
                  L0c == L0n ? "OK" : "FALLA"])
    # (ii) reparto premio+quemado = C
    e2 = escenario_de(central, 1e5, 1.0, 20.0, 0.0, 1e-3, 1e-3, :P1, 1e-3; s=s2)
    C = parte_confiscable(e2; ρ_ret=0.5, Tv=3600.0)
    prem = premio_incluidor(e2; ρ_ret=0.5, Tv=3600.0)
    quem = parte_quemada(e2; ρ_ret=0.5, Tv=3600.0)
    push!(filas, ["reparto premio+quemado", fmt(prem+quem;d=12), fmt(C;d=12), "s="*fmt(s2;d=4),
                  abs(prem+quem-C) <= 1e-12 ? "OK" : "FALLA"])
    # (iii) auto denuncia nunca rentable
    ad = autodenuncia(e2; ρ_ret=0.5, Tv=3600.0)
    push!(filas, ["autodenuncia perdida_neta", fmt(ad.perdida_neta;d=12),
                  "> 0 (cota ≥ (1−s)C = "*fmt(ad.cota_inferior;d=6)*")", "s="*fmt(s2;d=4),
                  (!ad.rentable && ad.perdida_neta > 0) ? "OK" : "FALLA"])
    # (iv) q_inclusion
    for (c,n) in ((0.0,1),(0.5,1),(1.0,1),(0.5,1019),(0.9,1019))
        push!(filas, ["q_inclusion(c="*fmt(c;d=2)*",n=$n)", fmt(q_inclusion(c,n);d=12),
                      "1−c^n", "G-SL2b-4", q_inclusion(c,n) ≈ 1-c^n ? "OK" : "FALLA"])
    end
    escribir_csv("comprobaciones-s2b.csv", ["caso","valor","esperado","etiqueta","resultado"], filas)
end
```

