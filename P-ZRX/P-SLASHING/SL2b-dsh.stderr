For `recomendacion_dev_s2`, I want minimal T_v covering the 5 cases for both attackers at s=0.25 (and maybe also at s=0.375). Actually `sensibilidad_s2` already gives the "cubre_5_casos" per ρ. The recommendation is the min over ρ of the max Tv. Let me write `recomendacion_dev_s2` to pick the best ρ per (s, atacante):
```julia
function recomendacion_dev_s2(casos)
    filas = Vector{Vector{String}}()
    αref, Pref, Vref, ehref, qgref = 0.40, 1e-3, 1e5, 1e-3, 20.0
    bm = beta_cache(αref, Pref)
    for s in grid("s_incluidor",[0.25]), conf in (false,true)
        mejor = (rho=NaN, Tv=Inf)
        for ρ in (0.10,0.25,0.50,1.00)
            todos=true; maxTv=0.0
            for caso in casos
                esc = escenario_de(caso, Vref, 1.0, qgref, 0.0, ehref, p("f_honesto"), :P1, Pref; s=s)
                reg = region_tv(esc, bm.βd; ρ_ret=ρ, confabulado=conf)
                if reg.existe; maxTv=max(maxTv,reg.Tv_min); else; todos=false; break; end
            end
            todos && maxTv < mejor.Tv && (mejor=(rho=ρ, Tv=maxTv))
        end
        push!(filas, [fmt(s;d=4), atacante(conf), fmt(mejor.rho;d=3), bool(isfinite(mejor.Tv)),
                      fmt(mejor.Tv;d=6), fmt(ceil(mejor.Tv/1e5)*1e5;d=4),
                      "α=0.40,P*=1e-3,V=1e5,f=1,q_g=20,ε_h=1e-3; cubre los 5 casos"])
    end
    escribir_csv("recomendacion-dev-s2.csv", ["s","atacante","rho_ret","existe","Tv_min_peor","Tv_recomendado","etiqueta"], filas)
end
```

