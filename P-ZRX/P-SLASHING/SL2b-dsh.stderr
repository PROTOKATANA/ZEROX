For the `sensibilidad_s` table, I'll compute at the hard point for all 5 cases:
```julia
function sensibilidad_s2(casos)
    filas = Vector{Vector{String}}()
    αref, Pref, Vref, ehref, qgref, fref = 0.40, 1e-3, 1e5, 1e-3, 20.0, 1.0
    bm = beta_cache(αref, Pref)
    for s in grid("s_incluidor", [0.25]), conf in (false, true), ρ in (0.10, 0.25, 0.50, 1.00)
        todos = true; maxTv = 0.0; detalle = String[]
        for caso in casos
            esc = escenario_de(caso, Vref, fref, qgref, 0.0, ehref, p("f_honesto"), :P1, Pref; s=s)
            reg = region_tv(esc, bm.βd; ρ_ret=ρ, confabulado=conf)
            if reg.existe
                maxTv = max(maxTv, reg.Tv_min); push!(detalle, caso.nombre*"="*fmt(reg.Tv_min;d=4))
            else
                todos=false; push!(detalle, caso.nombre*"=NO")
            end
        end
        push!(filas, [fmt(s;d=4), atacante(conf), fmt(ρ;d=3), bool(todos), fmt(maxTv;d=6), join(detalle,"; ")])
    end
    escribir_csv("sensibilidad-s.csv", ["s","atacante","rho_ret","cubre_5_casos","Tv_min_peor","detalle"], filas)
end
```
