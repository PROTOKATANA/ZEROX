```julia
function validar_s2b(esc_nos::Escenario, esc_con::Escenario; ρ_ret, Tv)
    Cn = parte_confiscable(esc_nos; ...)
    Cc = parte_confiscable(esc_con; ...)
    Ln = perdida_castigo(esc_nos; confabulado=true)   # s=0
    Ln2 = perdida_castigo(esc_nos; confabulado=false) # s=0
    Lc = perdida_castigo(esc_con; confabulado=true)
    Lno = perdida_castigo(esc_con; confabulado=false)
    ad = autodenuncia(esc_con; ...)
    err = max(abs(Cn-Cc), abs(Ln-Ln2), abs(Lc - ((1-esc_con.s)*Cc + esc_con.c_r)))
    ...
end
```
