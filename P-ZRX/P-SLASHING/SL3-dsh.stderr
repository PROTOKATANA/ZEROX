```julia
function _v_en_aplicacion(Epre, b, P, key)
    Ep = clonar(Epre)
    Transicion.promover!(Ep, b.slot, true)
    Transicion.podar_incidentes!(Ep, P, b.slot)
    for tx in b.txs
        tx.tipo == TxEvidencia && break
        r = Transicion.aplicar_tx!(Ep, b, P, b.slot, tx)
        r isa Err && break
    end
    return total_garantia(Ep.garantias[key])
end
```
