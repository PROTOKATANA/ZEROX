```julia
function _pd_ev(pd::ParamsDAG; Plazo::Int=3, Mm::Int=0, fn::Int=1, fd::Int=1)
    P = pd.P
    R = max(P.R_slots, Plazo + Mm + 1)
    Pe = Transicion.Params(H_dep=P.H_dep, M_cb=P.M_cb, M_dep=P.M_dep,
        H_corte_min=P.H_corte_min, W_min=P.W_min, S_min=P.S_min, K_min=P.K_min,
        q=P.q, M_res_slots=P.M_res_slots, M_dep_slots=P.M_dep_slots,
        M_rec_slots=P.M_rec_slots, R_slots=R, F_slots=P.F_slots, sec=P.sec,
        M_sec=P.M_sec, P_sec=P.P_sec, C_min=P.C_min, corte=P.corte,
        seleccion=P.seleccion, f_num=fn, f_den=fd, Plazo_slots=Plazo,
        M_margen_slots=Mm, cbid=7, evp=true)
    return ParamsDAG(Pe, pd.k)
end
```

