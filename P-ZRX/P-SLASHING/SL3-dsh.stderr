For coverage classification, define:
```julia
function clasificar_cobertura(bloques, P, acc::Dict{String,Int})
    memo, por_id = construir_validos(bloques, P)
    for b in bloques
        for tx in b.txs
            tx.tipo == TxEvidencia || continue
            estado = haskey(memo, b.id) ? memo[b.id] : nothing
            if estado === nothing
                # bloque inválido: recomputar error
                Ep = get(memo, b.padre, nothing)
                if Ep === nothing
                    acc["sin_padre"] = get(acc,"sin_padre",0)+1
                else
                    r = aplicar(Ep, b, P)
                    clave = tx.evidencia === nothing ? tx.clave : tx.evidencia.id1.clave
                    if r == ErrEvidenciaDuplicada
                        acc["duplicada"] = get(acc,"duplicada",0)+1
                    elseif r == ErrEvidenciaTardia
                        acc["tardia"] = ...
                    elseif r == ErrCbidAjeno ...
                    elseif r == ErrOrdenCanonico ... (etc)
                    else acc["otro_error"] += 1
                    end
                end
            else
                # aplicada; distinguir sin saldo
                ev = tx.evidencia
                if ev === nothing
                    acc["malformada"] += 1
                else
                    # detectar si la clave tenía saldo antes del bloque
                    Ep = get(memo, b.padre, nothing)
                    V = Ep === nothing ? Int128(0) :
                        (haskey(Ep.garantias, ev.id1.clave) ? total_garantia(Ep.garantias[ev.id1.clave]) : Int128(0))
                    if V == 0
                        acc["sin_saldo"] += 1
                    else
                        acc["aplicada"] += 1
                    end
                end
            end
        end
    end
end
```

