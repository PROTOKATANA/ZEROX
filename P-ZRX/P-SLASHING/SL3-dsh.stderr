```julia
function puntos_evidencia()
    out = Params[]
    for (f_num,f_den) in ((1,2),(1,1)), Plazo in (1,2,3), Mm in (0,1)
        R = Plazo + Mm + 1
        push!(out, Params(H_dep=1,M_cb=1,M_dep=0,H_corte_min=2,W_min=1,S_min=1,
               K_min=1,q=1,M_res_slots=1,M_dep_slots=1,M_rec_slots=1,R_slots=R,
               F_slots=typemax(Int),sec=SEC0,corte=CUT_HWPhi,seleccion=FC3,
               f_num=f_num,f_den=f_den,Plazo_slots=Plazo,M_margen_slots=Mm,
               cbid=7,evp=true))
    end
    return out
end
```

