```julia
function base_post(P; seed=7)
    t = construir_poW(StableRNG(seed), P; hasta=10, depositar=true, transferir=false)
    bl, es = t[1], t[2]
    E = es[end]
    for _ in 1:1
        B = gen_post(id=bl[end].id+1, padre=bl[end].id, slot=E.slot+1, productor=1, peso=1, txs=[tx_coinbase_post(3)])
        r = aplicar(E,B,P); r isa Err && break; E=r; push!(bl,B)
    end
    return bl, E
end
```
