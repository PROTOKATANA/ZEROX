Let me implement `evidencia_aleatoria(rng, S, P, slot)`:
```julia
function evidencia_aleatoria(rng, S, P, slot; cbid=nothing, key=nothing, sf=nothing)
    c = cbid === nothing ? P.cbid : cbid
    k = key === nothing ? (isempty(S.garantias) ? 1 : rand(rng, collect(keys(S.garantias)))) : key
    s = sf === nothing ? slot : sf
    ph1 = rand(rng, UInt64)
    ph2 = rand(rng, UInt64)
    (ph1 == ph2) && (ph2 = ph1 + UInt64(1))
    lo, hi = minmax(ph1, ph2)
    ev = Transicion.evidencia(c, k, 0, 0, 0, s, lo, hi)
    return Transicion.tx_evidencia(ev)
end
```
And injection:
```julia
if P.evp && rand(rng) < p_ev
    evid = evidencia_aleatoria(rng, S, P, slot; ...)
    push!(txs, evid)
end
```
