```julia
# Appends one PoST block with an evidence tx (and coinbase) on top of `estados[end]`.
function bloque_evidencia(P, bloques, estados; ev, productor=1, slot=nothing, con_coinbase=true, extra=Tx[])
    E = estados[end]; parent = bloques[end].id
    s = slot === nothing ? E.slot + 1 : slot
    txs = Tx[]
    con_coinbase && push!(txs, tx_coinbase_post(3))
    append!(txs, extra)
    push!(txs, tx_evidencia(ev))
    B = gen_post(id=parent+1, padre=parent, slot=s, productor=productor, peso=1, txs=txs)
    r = aplicar(E, B, P)
    return B, r
