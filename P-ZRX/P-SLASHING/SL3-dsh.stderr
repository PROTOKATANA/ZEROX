```julia
# Helpers to build PoST prefixes with a guarantee and evidence blocks.

# Base chain: valid PoW until terminal, then `n_post` PoST blocks, producer 1.
function cadena_post_base(P::Params; seed::Int = 1, n_post::Int = 2, hasta::Int = 10)
    rng = StableRNG(seed)
    t = construir_poW(rng, P; hasta = hasta, depositar = true, transferir = false)
    bloques, estados = t[1], t[2]
    E = estados[end]
    E.terminal == -1 && return bloques, estados
    parent = bloques[end].id
    slot = 0
    for _ in 1:n_post
        slot += 1
        B0 = gen_post(id = parent + 1, padre = parent, slot = slot, productor = 1, peso = 1,
                      txs = [tx_coinbase_post(3)])
        r = aplicar(E, B0, P)
        r isa Err && break
        E = r
        push!(bloques, B0)
        push!(estados, E)
        parent = B0.id
    end
    return bloques, estados
end
```

Wait, `construir_poW` uses ids and out_id internally but the returned `next_id` isn't used here; I use `parent+1`, which may collide with existing block ids? The PoW blocks have ids sequential from 2. `parent` is the last, so parent+1 is fresh. Good. But `construir_poW` may have stopped early; the ids are sequential. Fine.

Actually, the PoST blocks need to satisfy `B.slot > E.slot`; I increment. Good. Also `productor=1` needs activo ≥ q. After deposits, yes.

