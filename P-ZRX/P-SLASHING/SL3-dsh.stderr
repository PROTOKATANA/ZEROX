```julia
# aplicar el mergeset de B a mano para recoger descartes
function _descartes_mergeset(A, b)
    gd = A.gdr.gd[A.gidx[b.id]]
    sp_g = gd.sp
    base = sp_g == 1 ? Transicion.clonar(A.estado_T) : Transicion.clonar(A.post[A.id_g[sp_g]])
    out = Tuple{Int,Int,Transicion.Err}[]
    for xg in gd.ms_ordenado
        x_id = A.id_g[xg]; xb = A.por_id[x_id]
        get(gd.tipos, xg, 0x00) == 0x02 && continue
        base, d = aplicar_bloque_fusion!(A, base, xb, b.slot)
        for (i,e) in d; push!(out, (x_id,i,e)); end
    end
    return out
end
```
