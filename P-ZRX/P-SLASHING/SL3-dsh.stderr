Implementation:
```julia
function caso_rat3_carrera(P::Params)
    rng = StableRNG(0x9a3)
    bloques, est = _prefijo_ev(rng, P; n_post = 1)
    E = est[end]
    # verificar parámetros esperados
    (P.Plazo_slots >= 1 && P.M_margen_slots >= 0 && P.R_slots > P.Plazo_slots + P.M_margen_slots) || return nothing
    parent = bloques[end].id
    t0 = E.slot + 1
    # B0: retiro parcial
    g = get(E.garantias, 1, nothing)
    (g === nothing || g.activo < UInt64(P.q) + 1) && return nothing
    B0 = gen_post(id = parent + 1, padre = parent, slot = t0, productor = 1, peso = 1,
                  txs = [tx_coinbase_post(3), tx_retiro(1, 1, 1; nonce = nonce_de(E, 1))])
    E0 = aplicar(E, B0, P)
    E0 isa Err && return nothing
    ...
end
```

