I'll add:
```julia
    # SL-3: rejilla con C-EVP activo y evidencia.
    total_ev = 0
    total_ev_validos = 0
    total_ev_desc = 0
    ev_aplicadas = 0
    ev_duplicadas = 0
    ev_tardias = 0
    ev_cbid = 0
    for (pi, pdev) in enumerate(PARAMS_DAG_EV)
        fallos_punto = String[]
        for r in 1:replicas
            rng = StableRNG(seed + UInt64(20_000 * pi + r))
            A = generar_dag_aleatorio(rng, pdev; npost = npost_t04c(r), pesos = PESOS_AJUSTADOS)
            total_ev += 1
            total_ev_validos += count(v -> v, values(A.validos))
            _, _, desc = aplicar_historia(A)
            total_ev_desc += length(desc)
            for (_,_,e) in desc
                e == Transicion.ErrEvidenciaDuplicada && (ev_duplicadas += 1)
                e == Transicion.ErrEvidenciaTardia && (ev_tardias += 1)
                e == Transicion.ErrCbidAjeno && (ev_cbid += 1)
            end
            for f in verificar_ie1_ie2_ie4(A)
                push!(fallos_punto, "EV$pi r$r: $f")
            end
            for f in verificar_ie6(A)
                push!(fallos_punto, "EV$pi r$r: $f")
            end
            bloques = collect(values(A.por_id))
            for f in verificar_ie3(A, bloques; intentos = 50, semilla = UInt64(2_000_000 + 10_000*pi + r))
                push!(fallos_punto, "EV$pi r$r: $f")
            end
        end
        append!(fallos_globales, fallos_punto)
        println(io, "PUNTO-EV EV=$pi f=$(pdev.P.f_num)/$(pdev.P.f_den) Plazo=$(pdev.P.Plazo_slots) k=$(pdev.k) fallos=$(length(fallos_punto))")
        flush(io)
    end
    println(io, "TOTAL-EV historias=$total_ev validos=$total_ev_validos descartes=$total_ev_desc duplicadas=$ev_duplicadas tardias=$ev_tardias cbid=$ev_cbid")
```

This adds 8 points × 200 = 1600 evidence DAGs with `verificar_ie3` 50 orders each → 80k order resolutions. Combined with the existing ~3000 histories × 200 orders... The existing run took 58s at 3000 histories. Adding 1600 with 50 orders may add time. Fine.

