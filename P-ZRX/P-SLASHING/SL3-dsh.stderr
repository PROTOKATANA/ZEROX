### Freeze/liquidate

```julia
function total_garantia(g::Garantia)
    t = Int128(g.activo)
    for p in g.pendientes; t += p.importe; end
    for r in g.en_retirada; t += r.importe; end
    for p in g.creditos; t += p.importe; end
    return t
end
```

`debitar_garantia!(g, c::Int128)`: deterministic order activo, pendientes, en_retirada, creditos. Subtract as much as possible. Since C ≤ total, it should fully debit c. Return nothing. Need to handle UInt64 conversion safely.

```julia
function debitar_garantia!(g::Garantia, c::Int128)
    c <= 0 && return nothing
    restante = c
    # activo
    d = min(restante, Int128(g.activo))
    g.activo -= UInt64(d); restante -= d
    # pendientes
    nuevas = Pendiente[]
    for p in g.pendientes
        if restante > 0
            d = min(restante, Int128(p.importe))
            if d == Int128(p.importe)
                restante -= d
                continue
            else
                restante -= d
                push!(nuevas, Pendiente(p.importe - UInt64(d), p.madura_en_altura, p.madura_en_slot))
                continue
            end
        end
        push!(nuevas, p)
    end
    g.pendientes = nuevas
    # en_retirada
    nuevasr = EnRetirada[]
    for r in g.en_retirada
        if restante > 0
            d = min(restante, Int128(r.importe))
            if d == Int128(r.importe)
                restante -= d
                continue
            else
                restante -= d
                push!(nuevasr, EnRetirada(r.importe - UInt64(d), r.inicio_slot))
                continue
            end
        end
        push!(nuevasr, r)
    end
    g.en_retirada = nuevasr
    # creditos
    nuevasc = Pendiente[]
    for p in g.creditos
        if restante > 0
            d = min(restante, Int128(p.importe))
            if d == Int128(p.importe)
                restante -= d
                continue
            else
                restante -= d
                push!(nuevasc, Pendiente(p.importe - UInt64(d), p.madura_en_altura, p.madura_en_slot))
                continue
            end
        end
        push!(nuevasc, p)
    end
    g.creditos = nuevasc
    return nothing
end
```

Note: `g.activo -= UInt64(d)` where d ≤ activo, safe.

### acreditar credit for reward

```julia
function acreditar_credito!(E::Estado, P::Params, productor::Int, importe::UInt64, slot::Int)
    importe == 0 && return nothing
    g = obtener_garantia!(E, productor)
    madura = slot + P.M_rec_slots
    if madura <= slot
        return add_activo!(g, importe)
    end
    push!(g.creditos, Pendiente(importe, -1, madura))
    return nothing
end
```
Hmm `add_activo!` returns Err or nothing. But in evidence application we generally want to propagate Err (desbordamiento). Let me handle.

Actually reward credit maturity: RAT-2 "con la madurez de la coinbase PoST de ese bloque". In T01 `credito_post!` uses `madura = B.slot + P.M_rec_slots`. So use `B.slot + P.M_rec_slots`. Good.

### `aplicar_evidencia!`

```julia
function aplicar_evidencia!(E::Estado, B::Bloque, P::Params, punto::Int, tx::Tx)
    tx.evidencia === nothing && return ErrSinEvidencia
    ev = tx.evidencia
    # RAT-1
    (ev.id1.cbid == P.cbid && ev.id2.cbid == P.cbid) || return ErrCbidAjeno
    # EV-06 identidad común
    ev.id1 == ev.id2 || return ErrSinEvidencia
    # EV-01 orden canónico y pre_hash distintos
    ev.h1.pre_hash < ev.h2.pre_hash || return ErrOrdenCanonico
    # EV-07 sellos
    (ev.h1.sello_ok && ev.h2.sello_ok) || return ErrSinEvidencia
    # gate RAT-3
    P.R_slots > P.Plazo_slots + P.M_margen_slots || return ErrPuertaRAT3
    sf = ev.id1.slot
    (sf <= punto < sf + P.Plazo_slots) || return ErrEvidenciaTardia
    clave = ev.id1.clave
    g = obtener_garantia!(E, clave)
    iid = incident_id(ev.id1)
    if any(x -> x[1] == iid, g.incidentes)
        return ErrEvidenciaDuplicada
    end
    # EV-11 registro + poda previa
    podar_incidentes!(E, P, punto)   # prune before adding? 
    push!(g.incidentes, (iid, sf))
    sort!(g.incidentes, by = x -> x[1])
    # EV-17 freeze total
    V = total_garantia(g)
    g.congelado = V > typemax(UInt64) ? typemax(UInt64) : UInt64(V)
    # EV-19 C
    C = min(V, techo_fraccion(V, P.f_num, P.f_den))
    debitar_garantia!(g, C)
    # RAT-2
    recompensa = techo_dos_octavos(C)
    r = acreditar_credito!(E, P, B.productor, recompensa, B.slot)
    r isa Err && return r
    E.quemado += Int128(C) - Int128(recompensa)
    # congelado remanente = total actual
    g.congelado = UInt64(total_garantia(g))
    return nothing
end
```

Wait: the freeze `congelado` should be the total frozen at the moment, and after liquidation the remainder. But if `V=0`, C=0, congelado=0, incident registered. Good (EV-22).

