diff -ruN ws.orig/crates/zx-core/src/target.rs ws/crates/zx-core/src/target.rs
--- ws.orig/crates/zx-core/src/target.rs	2026-09-26 01:36:47.796117320 +0200
+++ ws/crates/zx-core/src/target.rs	2026-09-26 01:47:54.030047709 +0200
@@ -104,6 +104,120 @@
