```julia
function generar_cadena_post(rng, P, n; ...)
    pow, estados, next_id, out_id, prod = Transicion.construir_poW(...)
    E = estados[end]
    # extend chain with T01 cadena_post
    post_bloques, Efin, next = Transicion.cadena_post(P, E, next_id, pow[end].id, n; productor=1, peso=1, sector=0)
    # convert to BloquePost
    bps = [bl_desde_post(b) for b in post_bloques]
    return pow, bps, Efin
end
```
