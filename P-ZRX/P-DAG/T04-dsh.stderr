```julia
function tips_validas(A)
    # valid blocks with no valid child
    con_hijo = Set{Int}()
    for b in A.bloques
        A.validos[b.id] || continue
        for p in b.padres
            p == A.id_T && continue
            A.validos[p] && push!(con_hijo, p)
        end
    end
    return [b.id for b in A.bloques if A.validos[b.id] && !(b.id in con_hijo)]
end
```
