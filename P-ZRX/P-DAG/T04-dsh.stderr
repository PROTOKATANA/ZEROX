Let me think about `procesar_uno!` in detail:

```julia
function procesar_uno!(A::Admision, b::BloquePost)
    # Parents: existence and D-P08
    for p in b.padres
        if p != A.id_T && !haskey(A.por_id, p)
            return marcar_invalido!(A, b, :ErrSinPadre)
        end
    end
    if isempty(b.padres)
        return marcar_invalido!(A, b, :ErrSinPadre)
    end
    if A.id_T in b.padres && length(b.padres) != 1
        return marcar_invalido!(A, b, :ErrSinPadre)
    end
    for p in b.padres
        p == A.id_T && continue
        if !get(A.validos, p, false)
            return marcar_invalido!(A, b, :ErrSinPadre)
        end
    end
    # dedupe parents?
    if length(unique(b.padres)) != length(b.padres)
        return marcar_invalido!(A, b, :ErrSinPadre)
    end
    # slot form
    if b.slot < 1
        return marcar_invalido!(A, b, :ErrSlot)
    end
    # coinbase form
    ncb = 0; icb = 0
    for (i,tx) in enumerate(b.txs)
        if tx.tipo == Transicion.TxCoinbase || tx.tipo == Transicion.TxCoinbasePost
            ncb += 1; icb = i
        end
    end
    if ncb > 1
        return marcar_invalido!(A, b, :ErrEmision)
    end
    if ncb == 1
        icb == 1 || return marcar_invalido!(A, b, :ErrEmision)
        txcb = b.txs[1]
        txcb.tipo == Transicion.TxCoinbasePost || return marcar_invalido!(A, b, :ErrEmision)
        txcb.importe == 0 && return marcar_invalido!(A, b, :ErrSaldo)
    end
    # GDR structural + coloring
    padres_g = Int[]
    for p in b.padres
        push!(padres_g, p == A.id_T ? 1 : A.gidx[p])
    end
    gi = A.gdr.n + 1
    ok = GDR.anadir!(A.gdr, A.gparams, texto_id(b.id), padres_g, UInt64(b.slot), b.sd, b.sr, b.ident)
    if !ok
        motivo = A.gdr.motivo[end]
        return marcar_invalido!(A, b, mapear_motivo(motivo))
    end
    # record gdr mapping
    A.gidx[b.id] = gi
    A.id_g[gi] = b.id
    # Estado(past(B))
    base, err = estado_past!(A, b, gi)
    if err !== nothing
        # block invalid, but it's already in GDR; mark invalid
        return marcar_invalido!(A, b, err; ya_en_gdr=true)
    end
    # guarantee
    Sg = Transicion.clonar(base)
    if Sg.fase == Transicion.FasePoW
        Sg.fase = Transicion.FasePoST; Sg.s0 = 0
    end
    Transicion.promover!(Sg, b.slot, true)
    g = get(Sg.garantias, b.productor, nothing)
    activo = g === nothing ? UInt64(0) : g.activo
    if activo < UInt64(A.pd.P.q)
        return marcar_invalido!(A, b, :ErrGarantia; ya_en_gdr=true)
    end
    # valid: store past and apply
    A.past[b.id] = base
    S, desc = aplicar_bloque_fusion!(A, Transicion.clonar(base), b, b.slot)
    A.post[b.id] = S
    A.descartes[b.id] = desc
    A.validos[b.id] = true
    A.por_id[b.id] = b
    push!(A.orden, b.id)
    return :OK
end
```

