```julia
function estado_past!(A, B, gi)
    gd = A.gdr.gd[gi]
    sp_g = gd.sp
    if sp_g == 1
        base = Transicion.clonar(A.estado_T)
    else
        sp_id = A.id_g[sp_g]   # inverse mapping GDR index -> block id
        base = Transicion.clonar(A.post[sp_id])
        # (post[sp_id] includes sp_id applied)
    end
    # Fusion depth check + apply mergeset (excluding sp)
    for xg in gd.ms_ordenado
        x_id = A.id_g[xg]
        xb = A.por_id[x_id]
        if get(gd.tipos, xg, 0x00) == 0x02
            continue  # rojo_U3 inerte
        end
        if B.slot - xb.slot > A.pd.P.F_slots
            return nothing, :ErrMergeDepth
        end
        base, desc = aplicar_bloque_fusion!(A, base, xb, B.slot)
        # append desc to descartes of B? The discarded txs belong to block B's application of merges
        append!(A.descartes_merge[B.id], ((x_id, d...) ...))  # need format
    end
    return base, nothing
end
```

