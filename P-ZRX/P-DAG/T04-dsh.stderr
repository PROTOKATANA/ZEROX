function aplicar_bloque_fusion(A, S, B, P, punto)
    # phase transition
    if S.fase == FasePoW
        # must be the transition block: sp == T
        S.fase = FasePoST
        S.s0 = 0
    end
    promover!(S, punto, true)   # T01.promover!
    # form: exactly one coinbase, first
    ... (already checked at admission, but re-check)
    # apply txs, deferred coinbase
    tarifas = Int128(0)
    declared = UInt64(0)
    has_cb = false
    for (i, tx) in enumerate(B.txs)
        if tx.tipo == TxCoinbasePost
            has_cb = true; declared = tx.importe; continue
        end
        S2 = T01.clonar(S)
        r = T01.aplicar_tx!(S2, Xsynthetic(B,punto), P, punto, tx)
        if r isa T01.Err
            push!(descartes, (i, r))
        else
            # fees for transfers
            if tx.tipo == TxTransferencia
                tarifas += fees(tx, S)   # need input values before consumption
            end
            S = S2
        end
    end
    # coinbase
    if has_cb
        credito = min(declared, subsidio_post(B.slot, P) + UInt64(tarifas))  # careful types
        ... apply coinbase with amount credito ...
        S.emitido += Int128(credito) - tarifas
    else
        S.emitido += -tarifas
    end
    S.subsidio_acum += Int128(subsidio_post(B.slot, P))
    S.slot = punto
    S.bloque_raiz = B.id
    return S
end
```

