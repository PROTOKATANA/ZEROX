```julia
function revalidar_kaspa(dir)
    disc = String[]
    nblo = 0
    for dag in 0:5
        obj = _json_value(codeunits(read(joinpath(dir,"dag$dag.json"), String)), Ref(1))
        k = Int(obj["K"]); gen = obj["GenesisID"]
        nombres = String[gen]
        especs = Tuple{String,Vector{Int}}[]
        for bl in obj["Blocks"]
            id = bl["ID"]
            padres = [findfirst(==(String(p)), nombres) for p in bl["Parents"]]
            any(isnothing, padres) && push!(disc, "dag$dag padre desconocido")
            push!(nombres, id)
            push!(especs, (id, Int[p for p in padres if p !== nothing]))
        end
        params = GDR.Params(k=k, u2=false, u3_mode=GDR.U3_OFF, sp_mode=GDR.SP_KASPA, merge_mode=GDR.MERGE_KASPA)
        est = GDR.EstadoReferencia(params, gen)
        for (id, padres) in especs
            GDR.anadir!(est, params, id, padres, UInt64(0), UInt64(0), typemax(UInt64)-1, UInt64(0))
        end
        for (j, bl) in enumerate(obj["Blocks"])
            i = 1 + j
            sp_esp = findfirst(==(String(bl["ExpectedSelectedParent"])), nombres)
            blues_esp = [findfirst(==(String(x)), nombres) for x in bl["ExpectedBlues"]]
            reds_esp = [findfirst(==(String(x)), nombres) for x in bl["ExpectedReds"]]
            ok = est.gd[i].sp == sp_esp && est.gd[i].blues == blues_esp && est.gd[i].reds == reds_esp && est.gd[i].blue_score == UInt64(bl["ExpectedScore"])
            ok || push!(disc, "dag$dag bloque $i")
            nblo += 1
        end
    end
    return nblo, disc
end
```
Wait, `est.gd[i].blues` for `EstadoReferencia` is `[sp, ...azules]`. And `volcar_corpus` writes `blues=csv_ids(e, gd.blues)`. And the JSON `ExpectedBlues` — in GDR's `run.jl --kaspa`, it compares `ms_blues_de(est, i) == blues_esp`. `ms_blues_de(est, i) = est.gd[i].blues`. So the JSON `ExpectedBlues` includes the sp (e.g., dag0 B has ExpectedBlues=["A"] and sp=A). Yes. Good.

Also `est.gd[i].reds` compared to `ExpectedReds`. In GDR's kaspa test, `ms_reds_de(est,i) == reds_esp`. Good.

But the order of `blues`/`reds` must match. The JSON arrays are in the expected order. GDR's `blues` order matches. Good.

