```
# vectores-estado-dag-v0 · T04 · <fecha> · sha256 del contrato <hash>
CASO n=<n> nombre=<nombre> punto=<punto> k=<k> semilla=<semilla>
PARAM H_dep=.. M_cb=.. M_dep=.. H_corte_min=.. W_min=.. S_min=.. K_min=.. q=.. M_res_slots=.. M_dep_slots=.. M_rec_slots=.. R_slots=.. F_slots=.. k=.. sec=SEC0 corte=CUT_HWPhi seleccion=FC3
BLOQUE id=<id> fam=PoW padres=[<p>] altura=<h> trabajo=<t> pow_ok=1 slot=0 prod=0 peso=0 sr=0 sd=0 ident=0 reqdecl=0 ntx=<n>
TX tipo=Coinbase firmante=0 clave=0 importe=0 ent=[] sal=[<id>:<valor>:<dueño>,...]
RES bloque=<id> res=OK
...
BLOQUE id=<id> fam=PoST padres=[<p1>,<p2>] ... 
TX ...
RES bloque=<id> res=OK|ErrGarantia|...
...
DESC bloque=<id> tx=<idx> motivo=<Err>
SEL punta=<id>
UTXO dueño=.. valor=.. origen=.. altura=.. slot=..
GAR clave=.. activo=.. pend=[..] ret=[..] cred=[..] congelado=..
EST emitido=.. quemado=.. fase=.. terminal=.. altura=.. slot=.. peso_sufijo=..
FIN
```

