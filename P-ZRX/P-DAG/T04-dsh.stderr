Actually, one more design point: the `orden_aplicacion` for the virtual state, needed for IE-2 and the vector export. Let me implement:
```julia
function aplicacion_virtual(A)
    tips = tips_validas(A)
    if isempty(tips)
        return (Transicion.clonar(A.estado_T), Int[], Tuple{Int,Int,Symbol}[])
    end
    gtips = [A.gidx[t] for t in tips]
    spg = GDR.seleccionar_sp_ref(A.gdr, A.gparams, gtips)
    sp_id = A.id_g[spg]
    otros = [t for t in tips if t != sp_id]
    # orden C-GD-05
    sort!(otros; lt=(a,b) -> GDR.cmp_orden(A.gdr, A.gidx[a], A.gidx[b]) < 0)
    punto = maximum(A.por_id[t].slot for t in tips)
    S = Transicion.clonar(A.post[sp_id])
    desc = Tuple{Int,Int,Transicion.Err}[]
    aplicados = Int[]
    for t in otros
        xb = A.por_id[t]
        # merge depth
        if punto - xb.slot <= A.pd.P.F_slots
            S, d = aplicar_bloque_fusion!(A, S, xb, punto)
            push!(aplicados, t)
            for (i,e) in d; push!(desc, (t, i, e)); end
        else
            # should not happen for tips
        end
    end
    return S, aplicados, desc
end
```
And the selected chain:
```julia
function cadena_virtual(A)
    tips = tips_validas(A)
    isempty(tips) && return Int[]
    gtips = [A.gidx[t] for t in tips]
    spg = GDR.seleccionar_sp_ref(A.gdr, A.gparams, gtips)
    ch = GDR.cadena_seleccionada(A.gdr, spg)
    return [A.id_g[g] for g in ch]
end
```
