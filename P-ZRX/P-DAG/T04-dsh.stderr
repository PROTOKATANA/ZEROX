```julia
function estado_past!(A, b, gi)
    gd = A.gdr.gd[gi]
    sp_g = gd.sp
    if sp_g == 1
        base = Transicion.clonar(A.estado_T)
    else
        sp_id = A.id_g[sp_g]
        base = Transicion.clonar(A.post[sp_id])
    end
    for xg in gd.ms_ordenado
        x_id = A.id_g[xg]
        xb = A.por_id[x_id]
        if get(gd.tipos, xg, 0x00) == 0x02
            continue
        end
        if b.slot - xb.slot > A.pd.P.F_slots
            return base, :ErrMergeDepth
        end
        base, _ = aplicar_bloque_fusion!(A, base, xb, b.slot)
    end
    return base, nothing
end
```

