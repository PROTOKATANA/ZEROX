function _virtual_gdr(A)
    tips = tips_validas(A)
    isempty(tips) && return (nothing, nothing, tips)
    gtips = [A.gidx[t] for t in tips]
    gdr2 = deepcopy(A.gdr)
    GDR.anadir!(gdr2, A.gparams, "V", gtips, UInt64(maximum(A.por_id[t].slot for t in tips)), UInt64(0), UInt64(0), UInt64(0))
    return (gdr2, gdr2.n, tips)
end
```
