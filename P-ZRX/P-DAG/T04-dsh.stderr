```julia
function revalidar_corpus(ruta)
    disc = String[]; nblo = 0; ndag = 0
    params = nothing; est = nothing; nombres = Dict{String,Int}(); idx = 0
    for linea in eachline(ruta)
        isempty(strip(linea)) && continue
        startswith(linea, "#") && continue
        partes = split(linea)
        tipo = partes[1]
        if tipo == "DAG"
            ndag += 1
            # DAG <etiqueta> k=<k> u2=<u2> u3=<u3>
            kv = Dict(split(t, "=", limit=2)[1] => split(t, "=", limit=2)[2] for t in partes[3:end])
            k = parse(Int, kv["k"]); u2 = kv["u2"] == "1"
            u3 = kv["u3"] == "2" ? GDR.U3_DYNAMIC : (kv["u3"] == "1" ? GDR.U3_FILTER : GDR.U3_OFF)
            params = GDR.Params(k=k, u2=u2, u3_mode=u3, sp_mode=GDR.SP_ZEROX, merge_mode=GDR.MERGE_SPEC)
            est = nothing; nombres = Dict{String,Int}(); idx = 0
        elseif tipo == "B"
            kv = ... # parse fields
            id = kv["id"]
            padres = isempty(kv["padres"]) ? Int[] : [nombres[p] for p in split(kv["padres"], ",")]
            if est === nothing
                est = GDR.EstadoReferencia(params, id)
                nombres[id] = 1; idx = 1
            else
                ok = GDR.anadir!(est, params, id, padres, parse(UInt64, kv["slot"]), parse(UInt64,kv["sd"]), parse(UInt64,kv["sr"]), parse(UInt64,kv["ident"]))
                ok || push!(disc, "corpus: anadir! falló $id")
                idx += 1
                nombres[id] = idx
            end
        elseif tipo == "E"
            # compare
            ...
        elseif tipo == "END"
        end
    end
    return ndag, nblo, disc
end
```

The `B` line format: `B G slot=0 sd=0 sr=0 ident=0 padres=`. Note `padres=` (empty). Splitting by spaces: `["B","G","slot=0","sd=0","sr=0","ident=0","padres="]`. Good. The `id` is `partes[2]`.

The `E` line: `E G sp=- score=0 bw=0 ms= blues=G reds= colores= rank=0:0:G`. Fields: `E`, id, `sp=-`, `score=0`, `bw=0`, `ms=`, `blues=G`, `reds=`, `colores=`, `rank=0:0:G`. Note `ms=` can be empty. Parsing by `split(t,"=",limit=2)`. For `ms=`, value is "". Good.

