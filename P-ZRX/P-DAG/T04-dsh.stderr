Let me just write the proper minimal parser. It's cleaner and robust. I'll write it with `String` and `eachindex`-based cursor. Since all chars are ASCII, I can use byte indexing via `codeunits`. Let me write:

```julia
function _json_skipws(b::Base.CodeUnits{UInt8,String}, i::Base.RefValue{Int})
    n = length(b)
    while i[] <= n && (b[i[]] == 0x20 || b[i[]] == 0x0a || b[i[]] == 0x0d || b[i[]] == 0x09)
        i[] += 1
    end
end

function _json_str(b, i)
    @assert b[i[]] == UInt8('"'); i[] += 1
    io = IOBuffer()
    while b[i[]] != UInt8('"')
        if b[i[]] == UInt8('\\')
            i[] += 1
            c = b[i[]]
            if c == UInt8('n'); write(io, '\n')
            elseif c == UInt8('t'); write(io, '\t')
            else; write(io, c)
            end
        else
            write(io, b[i[]])
        end
        i[] += 1
    end
    i[] += 1
    return String(take!(io))
end

function _json_num(b, i)
    j = i[]
    while i[] <= length(b) && (isdigit(Char(b[i[]])) || b[i[]] in (UInt8('-'),UInt8('+'),UInt8('.'),UInt8('e'),UInt8('E')))
        i[] += 1
    end
    return parse(Float64, String(b[j:i[]-1]))
end
```
Then a recursive value parser returning `Any` (Dict/Vector/String/Float64/Bool/nothing). For `parse`, I'll convert K/Score to Int. This is fine.

