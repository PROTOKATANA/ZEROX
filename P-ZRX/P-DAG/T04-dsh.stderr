Now the constructor:
```julia
function Admision(pd::ParamsDAG, pow_bloques::Vector{Transicion.Bloque}, id_T::Int)
    P = pd.P
    gparams = GDR.Params(k=pd.k, max_parents=3, mergeset_limit=180, s_max=typemax(UInt64),
                         u2=true, u3_mode=GDR.U3_DYNAMIC, sp_mode=GDR.SP_ZEROX, merge_mode=GDR.MERGE_SPEC)
    gdr = GDR.EstadoReferencia(gparams, texto_id(id_T); slot_g=UInt64(0), sr_g=UInt64(0), ident_g=UInt64(0))
    # estado_T: apply the PoW chain
    S = Transicion.estado_inicial(P)
    for B in pow_bloques
        r = Transicion.aplicar!(S, B, P)
        r isa Transicion.Err && error("PoW inválido al construir Admision: $r")
    end
    Admision(pd, gparams, pow_bloques, id_T, S, BloquePost[], Dict{Int,Int}(), Dict(id_T=>1), Dict(id_T=>"T"), Dict{Int,Bool}(), Dict{Int,Symbol}(), Dict{Int,Transicion.Estado}(), Dict{Int,Transicion.Estado}(), Dict{Int,Vector{Tuple{Int,Transicion.Err}}}(), gdr, Int[])
end
```

