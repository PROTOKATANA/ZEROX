function estado_virtual(A)
    gdr2, gV, tips = _virtual_gdr(A)
    gdr2 === nothing && return (clonar(A.estado_T), Int[], Tuple{Int,Int,Transicion.Err}[])
    sp_g = gdr2.gd[gV].sp
    punto = ...
