Now, let me write the `aplicar_fusion` function. Let me be very careful.

```julia
"Punto de aplicación y subsidio propios de X: importe = subsidio_post(slot(X)); el resto usa punto."
function aplicar_bloque_fusion!(A::Admision, S::Transicion.Estado, B::BloquePost, punto::Int)
    P = A.pd.P
    desc = Tuple{Int,Transicion.Err}[]
    # Transición de fase (bloque de transición)
    if S.fase == Transicion.FasePoW
        S.fase = Transicion.FasePoST
        S.s0 = 0
    end
    Transicion.promover!(S, punto, true)
    # localizar coinbase
    ncb = 0; icb = 0
    for (i,tx) in enumerate(B.txs)
        if tx.tipo == Transicion.TxCoinbase || tx.tipo == Transicion.TxCoinbasePost
            ncb += 1; icb = i
        end
    end
    # (la forma se comprueba en admisión; aquí se asume ncb<=1)
    declared = UInt64(0)
    if ncb == 1
        declared = B.txs[icb].importe
    end
    tarifas = Int128(0)
    for (i,tx) in enumerate(B.txs)
        i == icb && continue
        if tx.tipo == Transicion.TxTransferencia
            # R-9
            if isempty(tx.entradas); push!(desc,(i,Transicion.ErrEmision)); continue; end
            if isempty(tx.salidas); push!(desc,(i,Transicion.ErrSaldo)); continue; end
            ve = Int128(0); falta = false
            for id in tx.entradas
                o = get(S.utxo, id, nothing)
                if o === nothing; falta = true; break; end
                ve += Int128(o.valor)
            end
            if falta; push!(desc,(i,Transicion.ErrDobleGasto)); continue; end
            vs = Int128(0)
            for s in tx.salidas; vs += Int128(s.valor); end
            if vs > ve; push!(desc,(i,Transicion.ErrSaldo)); continue; end
            S2 = Transicion.clonar(S)
            r = Transicion.aplicar_transferencia!(S2, P, punto, tx)
            if r isa Transicion.Err
                push!(desc,(i,r))
            else
                tarifas += ve - vs
                S = S2
            end
        else
            S2 = Transicion.clonar(S)
            r = Transicion.aplicar_tx!(S2, bloque_sintetico(B, punto), P, punto, tx)
            if r isa Transicion.Err
                push!(desc,(i,r))
            else
                S = S2
            end
        end
    end
    # coinbase recortada
    if ncb == 1
        sub = Int128(Transicion.subsidio_post(B.slot, P))
        credito = UInt64(min(Int128(declared), sub + tarifas))
        # aplicar crédito
        g = Transicion.obtener_garantia!(S, B.productor)
        madura = punto + P.M_rec_slots
        if madura <= punto
            r = Transicion.add_activo!(g, credito)
            r isa Transicion.Err && push!(desc, (icb, r))
        else
            push!(g.creditos, Transicion.Pendiente(credito, -1, madura))
        end
        S.emitido += Int128(credito) - tarifas
    else
        S.emitido += -tarifas
    end
    S.subsidio_acum += Int128(Transicion.subsidio_post(B.slot, P))
    S.slot = punto
    S.bloque_raiz = B.id
    return S, desc
end
```

