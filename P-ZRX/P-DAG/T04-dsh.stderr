function _json_value(b, i)
    _json_skipws(b, i)
    c = b[i[]]
    if c == UInt8('{')
        i[] += 1; d = Dict{String,Any}()
        _json_skipws(b, i)
        if b[i[]] == UInt8('}'); i[] += 1; return d; end
        while true
            _json_skipws(b, i)
            k = _json_str(b, i)
            _json_skipws(b, i); @assert b[i[]] == UInt8(':'); i[] += 1
            d[k] = _json_value(b, i)
            _json_skipws(b, i)
            if b[i[]] == UInt8(','); i[] += 1; continue
            else; @assert b[i[]] == UInt8('}'); i[] += 1; break; end
        end
        return d
    elseif c == UInt8('[')
        i[] += 1; v = Any[]
        _json_skipws(b, i)
        if b[i[]] == UInt8(']'); i[] += 1; return v; end
        while true
            push!(v, _json_value(b, i))
            _json_skipws(b, i)
            if b[i[]] == UInt8(','); i[] += 1; continue
            else; @assert b[i[]] == UInt8(']'); i[] += 1; break; end
        end
        return v
    elseif c == UInt8('"')
        return _json_str(b, i)
    elseif c == UInt8('t')
        i[] += 4; return true
    elseif c == UInt8('f')
        i[] += 5; return false
    elseif c == UInt8('n')
        i[] += 4; return nothing
    else
        return _json_num(b, i)
    end
end
```

