```
function caso_nonce_repeticion_fusionada(pd; seed=19)
    A, pow = base_dirigida(pd; seed=seed)
    P = pd.P
    id1 = pow[3]  # T04 uses last PoW id
    # Tb: first PoST block, slot 1, productor 1
    Tb = BloquePost(id=id1, padres=[A._id_T], slot=1, productor=1, peso=1,
                    txs=[tx_coinbase_post(3)])
    procesar_uno!(A, Tb)
    # Estado past(Tb) after applying Tb: key1 active etc.
    # The retiro tx uses key=1, importe=1, nonce = nonce_de(A.post[Tb.id],1)
    E = A.post[Tb.id]
    n1 = Transicion.nonce_de(E, 1)
    ret = Transicion.tx_retiro(1, 1, 1; nonce=n1)
    X1 = BloquePost(id=id1+1, padres=[Tb.id], slot=2, sd=0, productor=1, peso=1,
                    txs=[tx_coinbase_post(3), ret])
    X2 = BloquePost(id=id1+2, padres=[Tb.id], slot=2, sd=1, productor=1, peso=1,
                    txs=[tx_coinbase_post(3), ret])   # same tx object
    procesar_uno!(A, X1)
    procesar_uno!(A, X2)
    B = BloquePost(id=id1+3, padres=[X1.id, X2.id], slot=3, productor=1, peso=1,
                   txs=[tx_coinbase_post(3)])
    procesar_uno!(A, B)
    return "D-9", A, (Tb=Tb.id, X1=X1.id, X2=X2.id, B=B.id, n1=n1)
end
```
