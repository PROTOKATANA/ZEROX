```
function caso_nonce_reorg(pd; seed=21)
    A, pow = base_dirigida(pd; seed=seed)
    P = pd.P
    id1 = pow[3]
    Tb = BloquePost(id=id1, padres=[A._id_T], slot=1, productor=1, peso=1,
                    txs=[tx_coinbase_post(3)])
    procesar_uno!(A, Tb)
    n = nonce_de(A.post[Tb.id], 1)
    ret = tx_retiro(1, 1, 1; nonce=n)
    # Rama A (pesada): A1 con el retiro, A2.
    A1 = BloquePost(id=id1+1, padres=[Tb.id], slot=2, sr=0, productor=1, peso=1,
                    txs=[tx_coinbase_post(3), ret])
    A2 = BloquePost(id=id1+2, padres=[A1.id], slot=3, sr=0, productor=1, peso=1,
                    txs=[tx_coinbase_post(3)])
    procesar_uno!(A, A1); procesar_uno!(A, A2)
    tipA = mejor_punta(A, tips_validas(A))   # should be A2
    # Rama B (ligera al principio): B1 con el MISMO retiro.
    B1 = BloquePost(id=id1+3, padres=[Tb.id], slot=2, sr=typemax(UInt64), productor=1, peso=1,
                    txs=[tx_coinbase_post(3), ret])
    procesar_uno!(A, B1)
    # B2,B3 la hacen más pesada -> reorg
    B2 = BloquePost(id=id1+4, padres=[B1.id], slot=3, sr=0, productor=1, peso=1, txs=[tx_coinbase_post(3)])
    B3 = BloquePost(id=id1+5, padres=[B2.id], slot=4, sr=0, productor=1, peso=1, txs=[tx_coinbase_post(3)])
    procesar_uno!(A, B2); procesar_uno!(A, B3)
    tipB = mejor_punta(A, tips_validas(A))
    # volver a A
    A3 = BloquePost(id=id1+6, padres=[A2.id], slot=4, sr=0, productor=1, peso=1, txs=[tx_coinbase_post(3)])
    A4 = BloquePost(id=id1+7, padres=[A3.id], slot=5, sr=0, productor=1, peso=1, txs=[tx_coinbase_post(3)])
    procesar_uno!(A, A3); procesar_uno!(A, A4)
    tipA2 = mejor_punta(A, tips_validas(A))
    return "D-11", A, (n=n, Tb=Tb.id, A1=A1.id, A2=A2.id, B1=B1.id, B2=B2.id, B3=B3.id, A3=A3.id, A4=A4.id, tipA=tipA, tipB=tipB, tipA2=tipA2)
end
```
