+        assert_eq!(
+            total_candidatos, total_oraculo,
+            "slot {slot}: los candidatos reales deben coincidir con el oráculo"
+        );
+        assert_eq!(
+            total_candidatos, total_resumen,
+            "slot {slot}: el resumen debe contar los mismos candidatos que la API directa"
+        );
