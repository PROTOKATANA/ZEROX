function _elegir(rng, pesos::Vector{Float64})
    total = sum(pesos)
    x = rand(rng) * total
    acc = 0.0
    for i in eachindex(pesos)
        acc += pesos[i]
        x <= acc && return i
    end
    return length(pesos)
end
```
