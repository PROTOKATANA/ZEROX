Let me construct the new D-12:

```julia
function caso_retiro_liberacion_reorg(pd::ParamsDAG; seed::Int = 22)
    A, pow = base_dirigida(pd; seed = seed)
    id1 = pow[3]
    Tb = ... slot1 ...
    procesar_uno!(A, Tb)
    S0 = A.post[Tb.id]
    activo0 = S0.garantias[1].activo
    activo0 >= UInt64(1) || error(...)
    n0 = Transicion.nonce_de(S0, 1)
    A1 = ... slot2, sr=0, sd=5, retiro ...
    procesar_uno!(A, A1)
    A2 = ... slot3, sr=0, liberacion ...
    procesar_uno!(A, A2)
    S_lib = A.post[A2.id]
    libA = [o for (_,o) in S_lib.utxo if o.origen == OrigenLiberacion]
    length(libA)==1 || error(...)
    lib = libA[1]
    A3 = ... slot4, sr=0, sd=5, transfer spends lib ...
    procesar_uno!(A, A3)
    SA = A.post[A3.id]
    B1..B3 ... slot2..4, sr=0, sd=0 ...
    tipB = mejor_punta(...)
    SB,_,_ = estado_virtual(A)
    A4 ... slot5, sr=0 ...
    procesar_uno!(A,A4)
    tipA = mejor_punta(...)
    SA2,_,_ = estado_virtual(A)
    return "D-12", A, (..., libA = length(libA), libSA=count lib in SA, outSA=count 9501 in SA,
                       libSB=..., outSB=..., retSA=length(SA.garantias[1].en_retirada),
                       retSB=..., retSA2=..., nonceSA=..., nonceSB=..., nonceSA2=...)
end
```

