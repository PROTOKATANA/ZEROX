        if tip != prev_tip
            ops = _ops_garantia_aplicadas(A2)
            if !isempty(setdiff(prev_ops, ops))
                reorgs += 1
            end
            prev_ops = ops
            prev_tip = tip
        end
    end
    return reorgs
end
```
