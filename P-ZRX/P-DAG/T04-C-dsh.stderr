Let me write D-12 with explicit steps and verify with a quick run.

```
function caso_retiro_liberacion_reorg(pd::ParamsDAG; seed::Int = 22)
    A, pow = base_dirigida(pd; seed = seed)
    P = pd.P
    id1 = pow[3]
    # Tb slot 1
    Tb = BloquePost(id=id1, padres=[A._id_T], slot=1, productor=1, peso=1,
                    txs=Tx[tx_coinbase_post(3)])
    procesar_uno!(A, Tb)
    g0 = A.post[Tb.id].garantias[1]
    activo0 = g0.activo
    nonce0 = Transicion.nonce_de(A.post[Tb.id], 1)
    # A1 slot 2: retiro de 1 de la clave 1
    A1 = BloquePost(id=id1+1, padres=[Tb.id], slot=2, sr=0, productor=1, peso=1,
                    txs=Tx[tx_coinbase_post(3),
                           tx_retiro(1, UInt64(1), 1; nonce=nonce0)])
    procesar_uno!(A, A1)
    # A2 slot 3: liberación de 1 (inicio 2 + R_slots 1 = 3 <= 3)
    nA1 = Transicion.nonce_de(A.post[A1.id], 1)
    A2 = BloquePost(id=id1+2, padres=[A1.id], slot=3, sr=0, productor=1, peso=1,
                    txs=Tx[tx_coinbase_post(3), tx_liberacion(1, UInt64(1), 1; nonce=nA1)])
    procesar_uno!(A, A2)
    # UTXO de la liberación
    lib = nothing
    for (_, o) in A.post[A2.id].utxo
        o.origen == OrigenLiberacion && (lib = o)
    end
    lib === nothing && error("D-12: sin salida de liberación")
    # A3 slot 4: transferencia que gasta la salida de la liberación
    A3 = BloquePost(id=id1+3, padres=[A2.id], slot=4, sr=0, productor=1, peso=1,
                    txs=Tx[tx_coinbase_post(3),
                           tx_transferencia([lib.id],
                               [Salida(9501, lib.valor - UInt64(1), 1, OrigenTx, -1, -1)], 1)])
    procesar_uno!(A, A3)
    tipA = mejor_punta(A, tips_validas(A))
    # Rama B (no incluye A1..A3): pesada y con slots crecientes.
    B1 = BloquePost(id=id1+4, padres=[Tb.id], slot=5, sr=0, ... )
    ...
```

