Current structure:
```
function generar_dag_aleatorio(rng, pd; npost=8, p_tx=0.5, p_invalido=0.12)
    P = pd.P
    pow = generar_pow_terminal(rng, P)
    A = _admision_desde_pow(pd, pow)
    ids = Int[]; validos = Int[]
    next_id = pow[3]; out_id = pow[4]
    ident_pendiente = 0; ident_padres = Int[]; ident_slot = 0
    for i in 1:npost
        ... choose parents (and brother)
        slot = ...
        sr = ...
        sd = ...
        productor = ...
        sub = subsidio_post(slot,P)
        declarado = ...
        txs = [coinbase]
        if rand < p_tx && !isempty(validos)
            pv = validos[rand]
            S = A.post[pv]
            gastables = spendable outputs with valor≥2
            if !isempty
                o = gastables[rand]
                if rand < 0.5: transfer
                else: deposit
            end
        end
        b = BloquePost(...)
        procesar_uno!(A, b)
        ...
    end
    return A
end
```

I'll rewrite the transaction-construction part:

```
if rand(rng) < p_tx && !isempty(validos)
