        b = A.por_id[bid]
        for (i,tx) in enumerate(b.txs)
            tipo in TIPOS_CFG || continue
            if haskey(descpor, (bid,i))
                err = descpor[(bid,i)]
                ac.descartes[tipo][err] = get(...)+1
            else
                ac.aplicadas[tipo] += 1
            end
        end
    end
    # 2) reorgs
    ac.reorgs += reorgs_que_deshacen_garantia(A)
    ac.casos += 1
end
