Now D-13:
```julia
"""
D-13 · Liberación inmadura en el slot propio de X (`inicio + R_slots > s`) que sí
madura en el slot de su fusionador Y (`slot(Y) ≥ inicio + R_slots`). RD-4: un
bloque de lado se aplica en el slot del fusionador. Se documentan las dos vistas.
"""
function caso_liberacion_punto_aplicacion(pd::ParamsDAG; seed::Int = 23)
    A, pow = base_dirigida(pd; seed = seed)
    id1 = pow[3]
    Tb = BloquePost(id = id1, padres = [A._id_T], slot = 1, productor = 1, peso = 1,
                    txs = Transicion.Tx[Transicion.tx_coinbase_post(3)])
    procesar_uno!(A, Tb)
    n0 = Transicion.nonce_de(A.post[Tb.id], 1)
    # W: retiro en el slot 2 (inicio = 2).
    W = BloquePost(id = id1 + 1, padres = [Tb.id], slot = 2, sr = 0, productor = 1,
                   peso = 1,
                   txs = Transicion.Tx[Transicion.tx_coinbase_post(3),
                       Transicion.tx_retiro(1, 1, 1; nonce = n0)])
    procesar_uno!(A, W)
    # X: liberación en su propio slot 2 (aún no vencida: 2+1 > 2). Bloque válido.
    X = BloquePost(id = id1 + 2, padres = [W.id], slot = 2, sr = typemax(UInt64),
                   sd = 0, productor = 1, peso = 1,
                   txs = Transicion.Tx[Transicion.tx_coinbase_post(3),
                       Transicion.tx_liberacion(1, 1, 1;
                           nonce = Transicion.nonce_de(A.post[W.id], 1))])
    procesar_uno!(A, X)
    # Z: bloque de cadena pesado en el slot 3 (hijo de W).
    Z = BloquePost(id = id1 + 3, padres = [W.id], slot = 3, sr = 0, productor = 1,
                   peso = 1, txs = Transicion.Tx[Transicion.tx_coinbase_post(3)])
    procesar_uno!(A, Z)
    # Y: fusiona Z (sp) y X en el slot 3 ⇒ X se aplica en slot 3 (vencida).
    Y = BloquePost(id = id1 + 4, padres = [Z.id, X.id], slot = 3, sr = 0,
                   productor = 1, peso = 1,
                   txs = Transicion.Tx[Transicion.tx_coinbase_post(3)])
    procesar_uno!(A, Y)
    spY = A.id_g[A.gdr.gd[A.gidx[Y.id]].sp]
    # Vista de X (aplicado en su propio slot 2): liberación descartada.
    libX = [o for (_, o) in A.post[X.id].utxo if o.origen == Transicion.OrigenLiberacion]
    descX = get(A.descartes, X.id, Tuple{Int,Transicion.Err}[])
    # Vista de Y: X aplicado en slot(Y) = 3 ⇒ liberación aplicada.
    libY = [o for (_, o) in A.past[Y.id].utxo if o.origen == Transicion.OrigenLiberacion]
    return "D-13", A, (Tb = Tb.id, W = W.id, X = X.id, Z = Z.id, Y = Y.id,
                       spY = spY, slotY = A.por_id[Y.id].slot,
                       slotX = A.por_id[X.id].slot, libX = length(libX),
                       libY = length(libY),
                       libY_slot = isempty(libY) ? -1 : libY[1].creada_en_slot,
                       descX = descX)
end
```

