Now the coverage functions. Let me add after the generator:

```
# --- cobertura (ORDEN-T04-C §2) --------------------------------------------

const TIPOS_COBERTURA = (Transicion.TxTransferencia, Transicion.TxDeposito,
                         Transicion.TxRetiro, Transicion.TxLiberacion)
const TIPOS_GARANTIA = (Transicion.TxDeposito, Transicion.TxRetiro,
                        Transicion.TxLiberacion)

mutable struct AcumuladorCobertura
    generadas::Dict{Transicion.TipoTx,Int}
    construidas::Dict{Transicion.TipoTx,Int}
    aplicadas::Dict{Transicion.TipoTx,Int}
    descartes::Dict{Transicion.TipoTx,Dict{Transicion.Err,Int}}
    reorgs_garantia::Int
    casos::Int
end

function AcumuladorCobertura()
    mk(D) = Dict{Transicion.TipoTx,Int}(t => 0 for t in TIPOS_COBERTURA)
    mkd() = Dict{Transicion.TipoTx,Dict{Transicion.Err,Int}}(
        t => Dict{Transicion.Err,Int}() for t in TIPOS_COBERTURA)
    return AcumuladorCobertura(mk(), mk(), mk(), mkd(), 0, 0)
end
```

Then `_ops_garantia_aplicadas(A)` and `reorgs_que_deshacen_garantia(A)`:
```
function operaciones_garantia_aplicadas(A::Admision)
    _, orden, desc = aplicar_historia(A)
    descartadas = Set{Tuple{Int,Int}}()
    for (idb, itx, _) in desc
        push!(descartadas, (idb, itx))
    end
    ops = Set{Tuple{Int,Int}}()
    for bid in orden
        b = A.por_id[bid]
        for (i, tx) in enumerate(b.txs)
            if tx.tipo in TIPOS_GARANTIA && !((bid, i) in descartadas)
                push!(ops, (bid, i))
            end
        end
    end
    return ops
end

function reorgs_que_deshacen_garantia(A::Admision)
    A2 = Admision(A.pd, A.pow_bloques, A._id_T)
    bloques = sort(collect(values(A.por_id)); by = b -> b.id)
    prev_tip = A._id_T
    prev_ops = Set{Tuple{Int,Int}}()
    reorgs = 0
    for b in bloques
        b.id in A2.procesados && continue
        procesar_uno!(A2, b)
        tips = tips_validas(A2)
        isempty(tips) && continue
        tip = mejor_punta(A2, tips)
        tip == prev_tip && continue
        ops = operaciones_garantia_aplicadas(A2)
        isempty(setdiff(prev_ops, ops)) || (reorgs += 1)
        prev_tip = tip
        prev_ops = ops
    end
    return reorgs
end
```

Then `acumular_caso!`:
```
function acumular_caso!(ac::AcumuladorCobertura, A::Admision)
    for b in values(A.por_id)
        for tx in b.txs
            tx.tipo in TIPOS_COBERTURA && (ac.generadas[tx.tipo] += 1)
        end
    end
    _, orden, desc = aplicar_historia(A)
    descartes = Dict{Tuple{Int,Int},Transicion.Err}()
    for (idb, itx, err) in desc
        descartes[(idb, itx)] = err
    end
    for bid in orden
        b = A.por_id[bid]
        for (i, tx) in enumerate(b.txs)
            tx.tipo in TIPOS_COBERTURA || continue
            ac.construidas[tx.tipo] += 1
            if haskey(descartes, (bid, i))
                err = descartes[(bid, i)]
                ac.descartes[tx.tipo][err] = get(ac.descartes[tx.tipo], err, 0) + 1
            else
                ac.aplicadas[tx.tipo] += 1
            end
        end
    end
    ac.reorgs_garantia += reorgs_que_deshacen_garantia(A)
    ac.casos += 1
    return ac
end
```

Then `cobertura_run` for exportar.jl:
```
function cobertura_run(; seed::UInt64 = UInt64(0x5a5a), replicas::Int = 200)
    ac = AcumuladorCobertura()
    for (pi, k) in PUNTOS_T04
        pd = ParamsDAG(PARAMS_DAG_BASE[pi], k)
        for r in 1:replicas
            rng = StableRNG(seed + UInt64(10_000 * pi + r))
            A = generar_dag_aleatorio(rng, pd; npost = 3 + (r % 12))
            acumular_caso!(ac, A)
        end
    end
    return ac
end
```

And a renderer function that writes the table:
```
"Nombres de los cuatro tipos para la tabla de cobertura."
const NOMBRE_TIPO_COB = Dict(Transicion.TxTransferencia => "Transferencia",
                             Transicion.TxDeposito => "Deposito",
                             Transicion.TxRetiro => "Retiro",
                             Transicion.TxLiberacion => "Liberacion")

function escribir_cobertura(io::IO, titulo::AbstractString, ac::AcumuladorCobertura)
    println(io, titulo)
    println(io, "casos = ", ac.casos)
    println(io, "tipo generadas construidas aplicadas descartadas_total ",
                "ErrNonce ErrDobleGasto ErrSaldo ErrRetiroPendiente ErrAutorizacion ErrInmaduro ErrOperacionFase ErrEmision otros")
    for t in TIPOS_COBERTURA
        dtot = sum(values(ac.descartes[t]); init = 0)
        en_hist = ac.construidas[t]
        fila = [string(ac.generadas[t]), string(ac.construidas[t]),
                string(ac.aplicadas[t]), string(dtot)]
        for e in (Transicion.ErrNonce, Transicion.ErrDobleGasto, Transicion.ErrSaldo,
                  Transicion.ErrRetiroPendiente, Transicion.ErrAutorizacion,
                  Transicion.ErrInmaduro, Transicion.ErrOperacionFase, Transicion.ErrEmision)
            push!(fila, string(get(ac.descartes[t], e, 0)))
        end
        conocidos = sum(get(ac.descartes[t], e, 0) for e in (Transicion.ErrNonce,
            Transicion.ErrDobleGasto, Transicion.ErrSaldo, Transicion.ErrRetiroPendiente,
            Transicion.ErrAutorizacion, Transicion.ErrInmaduro, Transicion.ErrOperacionFase,
            Transicion.ErrEmision))
        push!(fila, string(dtot - conocidos))
        println(io, join(vcat([NOMBRE_TIPO_COB[t]], fila), " "))
    end
    g_cons = sum(ac.construidas[t] for t in TIPOS_GARANTIA)
    g_errnonce = sum(get(ac.descartes[t], Transicion.ErrNonce, 0) for t in TIPOS_GARANTIA)
    println(io, "garantia_construidas = ", g_cons)
    println(io, "garantia_errnonce = ", g_errnonce)
    @printf(io, "garantia_errnonce_pct = %.2f\n", g_cons == 0 ? 0.0 : 100.0 * g_errnonce / g_cons)
    println(io, "reorganizaciones_que_deshacen_garantia = ", ac.reorgs_garantia)
    return nothing
end
```

