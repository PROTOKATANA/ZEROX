```
function _ops_garantia_aplicadas(A)
    S, orden, desc = aplicar_historia(A)
    descset = Set{Tuple{Int,Int}}()
    for (idb,itx,err) in desc
        push!(descset, (idb,itx))
    end
    ops = Set{Tuple{Int,Int}}()
    for bid in orden
        b = A.por_id[bid]
        for (i,tx) in enumerate(b.txs)
            if tx.tipo in (Transicion.TxDeposito, Transicion.TxRetiro, Transicion.TxLiberacion)
                (bid,i) in descset || push!(ops, (bid,i))
            end
        end
    end
    return ops
end
```

