+[dev-dependencies]
+# §3.1: `zx-consensus` entra solo como `dev-dependency` (la excepción declarada) para minar la cadena
+# PoW dev de la prueba V5. `zx-farmer` entra como `dev-dependency` para implementar el puente real
+# `FuenteSoluciones → ParcelaDisco` en los tests; `frontera-crates.sh` solo mira dependencias que no
+# son `dev`, así que la frontera §V8 `zx-post → {zx-core, zx-pot, zx-dag, zx-poas}` se conserva.
+zx-consensus             = { path = "../zx-consensus" }
+zx-farmer                = { path = "../zx-farmer" }
+subspace-core-primitives = { path = "../../PDF/autonomys-subspace/crates/subspace-core-primitives", default-features = false, features = ["std"] }
