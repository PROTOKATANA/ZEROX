+    let mut cache = CachePotVerificada::nueva();
+    let mut presupuesto = PresupuestoPrueba::nuevo(1_000);
+
+    let estado = verificar_cabecera_conjunta(
+        &bloque,
+        &mundo,
+        &mundo,
+        &mundo,
