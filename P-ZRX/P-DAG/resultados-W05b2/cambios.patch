+/// Existe para que el núcleo pueda rechazar **más de una** sin confiar en que el contexto las
+/// cuente bien (`C-POT-01`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum InyeccionesPot {
+    /// Ninguna.
+    Ninguna,
