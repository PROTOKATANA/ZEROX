+
+    /// Ruta **instrumentada**: la espía de PoAS devuelve una distancia. No es la función pública.
+    #[test]
+    fn la_espia_de_poas_ok_registra_los_hechos_solo_al_final() {
+        let (cabecera, justificacion, mundo) = escenario();
