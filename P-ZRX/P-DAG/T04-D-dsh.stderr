```
function crear_utxos!(E::Estado, salidas::Vector{Salida}, origen::Origen,
                      altura::Int, slot::Int)
    vistos = Set{Int}()
    for s in salidas
        (s.id in vistos) && return ErrDobleGasto
        push!(vistos, s.id)
        haskey(E.utxo, s.id) && return ErrDobleGasto
    end
    for s in salidas
        E.utxo[s.id] = Salida(s.id, s.valor, s.dueño, origen, altura, slot)
    end
    return nothing
end
```
