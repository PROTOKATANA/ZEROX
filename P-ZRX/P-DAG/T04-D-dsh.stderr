Let me now write the D-14 function. I'll model it after D-12/D-13.

```julia
"""
D-14 · Dos liberaciones distintas (mismo nonce, importes distintos) de la misma
clave en ramas hermanas y una transferencia que gasta la salida de una de ellas.
Al fusionar, una liberación aplica y la otra se descarta con `ErrNonce`; la
transferencia de la rama aplicada aplica y la de la rama descartada se descarta
por entrada ausente (`ErrDobleGasto`), nunca por colisión de ids (los `ID_LIB`
de importes distintos son distintos).
"""
function caso_dos_liberaciones_hermanas(pd::ParamsDAG; seed::Int = 24)
    A, pow = base_dirigida(pd; seed = seed)
    id1 = pow[3]
    Tb = BloquePost(id = id1, padres = [A._id_T], slot = 1, productor = 1, peso = 1,
                    txs = T.Tx[T.tx_coinbase_post(3)])
    procesar_uno!(A, Tb)
    n0 = T.nonce_de(A.post[Tb.id], 1)
    v = UInt64(3)
    a = UInt64(1)
    b = UInt64(2)
    # W: retiro de importe 3 en slot 2 (vencido en 2 + R_slots).
    W = BloquePost(id = id1 + 1, padres = [Tb.id], slot = 2, sr = 0, productor = 1,
                   peso = 1, txs = T.Tx[T.tx_coinbase_post(3),
                       T.tx_retiro(1, v, 1; nonce = n0)])
    procesar_uno!(A, W)
    n1 = T.nonce_de(A.post[W.id], 1)
    # Xa y Xc: liberaciones hermanas, mismo nonce n1, importes a ≠ b.
    Xa = BloquePost(id = id1 + 2, padres = [W.id], slot = 3, sd = 0, sr = 0,
                    productor = 1, peso = 1,
                    txs = T.Tx[T.tx_coinbase_post(3),
                        T.tx_liberacion(1, a, 1; nonce = n1)])
    Xc = BloquePost(id = id1 + 3, padres = [W.id], slot = 3, sd = 1, sr = typemax(UInt64),
                    productor = 1, peso = 1,
                    txs = T.Tx[T.tx_coinbase_post(3),
                        T.tx_liberacion(1, b, 1; nonce = n1)])
    procesar_uno!(A, Xa)
    procesar_uno!(A, Xc)
    primero = GDR.cmp_orden(A.gdr, A.gidx[Xa.id], A.gidx[Xc.id]) < 0 ? Xa.id : Xc.id
    segundo = primero == Xa.id ? Xc.id : Xa.id
    imp_primero = primero == Xa.id ? a : b
    imp_segundo = primero == Xa.id ? b : a
    id_primero = T.ID_LIB(1, n1, imp_primero)
    id_segundo = T.ID_LIB(1, n1, imp_segundo)
    # Xb: hijo del primero con transferencia que gasta la salida de `primero`.
    Xb = BloquePost(id = id1 + 4, padres = [primero], slot = 3, productor = 1, peso = 1,
                    txs = T.Tx[T.tx_coinbase_post(3),
                        T.tx_transferencia([id_primero],
                            [T.Salida(9701, imp_primero, 1, T.OrigenTx, -1, -1)], 1)])
    procesar_uno!(A, Xb)
    # Xd: hijo del segundo con transferencia que gasta la salida de `segundo`.
    Xd = BloquePost(id = id1 + 5, padres = [segundo], slot = 3, productor = 1, peso = 1,
                    txs = T.Tx[T.tx_coinbase_post(3),
                        T.tx_transferencia([id_segundo],
                            [T.Salida(9702, imp_segundo, 1, T.OrigenTx, -1, -1)], 1)])
    procesar_uno!(A, Xd)
    B = BloquePost(id = id1 + 6, padres = [Xb.id, Xd.id], slot = 4, sr = 0,
                   productor = 1, peso = 1, txs = T.Tx[T.tx_coinbase_post(3)])
    procesar_uno!(A, B)
    S, _, desc = aplicar_historia(A)
    ...
end
```

