+    /// Bloque sintético con identidad explícita (el helper `bloque` de arriba siempre es
+    /// `SinBillete`).
+    fn bloque_con_ident(
+        bloque_id: BlockHash,
+        padres: Vec<BlockHash>,
+        slot: u64,
+        sr: u64,
+        identidad: IdentidadGhostdag,
+    ) -> BloqueGhostdag {
