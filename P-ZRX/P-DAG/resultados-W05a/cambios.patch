+            .anadir_sintetico(BloqueGhostdag {
+                id: hash_de_id_textual(id),
+                padres: vec![hash_de_id_textual("G")],
+                slot: 1,
+                solution_distance: 5,
+                rango_espacio: RangoSolucionValidado::para_oraculos(5),
+                identidad: IdentidadGhostdag::Sintetica(7),
+            })
+            .unwrap();
