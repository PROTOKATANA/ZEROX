+            identidad: IdentidadGhostdag::SinBillete,
+        })
+        .unwrap();
+    let idx_s = almacen.datos(c).unwrap().rojos.first().copied().unwrap();
+    assert_eq!(almacen.color_en(c, idx_s), Some(Color::RojoU3));
+}
