+#[test]
+fn peso_fronteras() {
+    // SR=0 → 2^128; SR=2^64−1 → 2^64.
+    assert_eq!(peso(0), U256::one() << 128usize);
+    assert_eq!(peso(u64::MAX), U256::one() << 64usize);
+    for sr in [0u64, 1, 2, 1 << 32, u64::MAX - 1, u64::MAX] {
+        assert!(peso(sr) >= (U256::one() << 64usize));
