+use zx_dag::ghostdag::{
+    Algoritmo, AlmacenGhostdag, BloqueGhostdag, Color, DatosGhostdag, IdentidadGhostdag, Idx,
+    ModoMerge, ModoSp, Parametros, Rank, hash_de_id_textual, peso, sumar_blue_work,
