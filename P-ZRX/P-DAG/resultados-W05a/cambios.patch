+/// Contexto de rango de los tests: un valor fijo. No hay controlador.
+struct CtxRangoFijo(u64);
+
+impl ContextoRangoDag for CtxRangoFijo {
+    fn rango_esperado(&self, _c: &CandidatoSinRango<'_>) -> Result<u64, ErrorDag> {
+        Ok(self.0)
+    }
+}
